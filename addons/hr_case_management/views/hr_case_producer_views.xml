<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Question form popup ─────────────────────────────────────────────── -->
    <record id="view_hr_case_producer_question_form" model="ir.ui.view">
        <field name="name">hr.case.producer.question.form</field>
        <field name="model">hr.case.producer.question</field>
        <field name="arch" type="xml">
            <form string="Question">
                <sheet>
                    <group>
                        <group>
                            <field name="label" placeholder="e.g. What is the issue?"/>
                            <field name="field_type"/>
                            <field name="required"/>
                        </group>
                        <group>
                            <field name="help_text" placeholder="Optional hint for the employee"/>
                            <field name="placeholder"
                                   placeholder="Shown inside empty text fields"
                                   invisible="field_type in ('boolean', 'date', 'employee', 'selection')"/>
                            <field name="map_to_field"/>
                        </group>
                    </group>
                    <group string="Choices"
                           invisible="field_type != 'selection'">
                        <field name="selection_values"
                               widget="text"
                               nolabel="1"
                               colspan="2"
                               placeholder="Option A&#10;Option B&#10;Option C"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Producer list (admin) ───────────────────────────────────────────── -->
    <record id="view_hr_case_producer_list" model="ir.ui.view">
        <field name="name">hr.case.producer.list</field>
        <field name="model">hr.case.producer</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="service_id"/>
                <field name="submission_count" string="Submissions"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ── Producer form (admin) ───────────────────────────────────────────── -->
    <record id="view_hr_case_producer_form" model="ir.ui.view">
        <field name="name">hr.case.producer.form</field>
        <field name="model">hr.case.producer</field>
        <field name="arch" type="xml">
            <form string="Form Template">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_open_submissions"
                                class="oe_stat_button" icon="fa-inbox">
                            <field name="submission_count"
                                   widget="statinfo"
                                   string="Submissions"/>
                        </button>
                        <button type="object" name="action_open_form_url"
                                class="oe_stat_button" icon="fa-external-link"
                                title="Open the employee-facing form in a new browser tab">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Open Form</span>
                            </div>
                        </button>
                    </div>
                    <field name="image" widget="image"
                           class="oe_avatar"
                           options="{'preview_image': 'image'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Form Name…"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="service_id"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Direct Link (share this URL with employees)">
                        <field name="form_url"
                               widget="url"
                               nolabel="1"
                               colspan="2"
                               readonly="1"/>
                    </group>
                    <group string="Instructions (shown to employees before filling the form)">
                        <field name="description"
                               nolabel="1"
                               colspan="2"
                               placeholder="Describe when to use this form, what to expect, and any relevant policy…"/>
                    </group>
                    <notebook>
                        <page string="Questions" name="questions">
                            <field name="question_ids"
                                   context="{'form_view_ref': 'hr_case_management.view_hr_case_producer_question_form'}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="label" placeholder="Question text…"/>
                                    <field name="field_type"/>
                                    <field name="required" widget="boolean_toggle"/>
                                    <field name="map_to_field" optional="show"/>
                                    <field name="help_text" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Admin action ───────────────────────────────────────────────────── -->
    <record id="action_hr_case_producer" model="ir.actions.act_window">
        <field name="name">Form Templates</field>
        <field name="res_model">hr.case.producer</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--
        Backend client action — opens the OWL service-request form.
        URL:  /odoo/action-hr_case_management.action_hr_case_service_form
        The producer_id must be in the action context (set by action_start_submission).
    -->
    <record id="action_hr_case_service_form" model="ir.actions.client">
        <field name="name">Submit HR Service Request</field>
        <field name="tag">hr_case.service_form</field>
        <field name="target">current</field>
    </record>

</odoo>
