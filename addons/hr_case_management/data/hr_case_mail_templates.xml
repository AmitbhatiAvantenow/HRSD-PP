<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_hr_case_created" model="mail.template">
        <field name="name">HR Case: Opened</field>
        <field name="model_id" ref="model_hr_case"/>
        <field name="subject">HR Case {{ object.name }} has been opened</field>
        <field name="email_to">{{ object.team_id.notification_email or '' }}</field>
        <field name="partner_to">{{ object.employee_id.user_id.partner_id.id or '' }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
            <div style="margin:0;padding:0;">
                <p>A new HR case <strong t-out="object.name or ''"/> has been opened
                   for <span t-out="object.employee_id.name or ''"/>.</p>
                <p>Service: <span t-out="object.service_id.name or ''"/><br/>
                   Category: <span t-out="object.category_id.name or ''"/><br/>
                   Priority: <span t-out="dict(object._fields['priority'].selection).get(object.priority)"/></p>
                <p t-out="object.short_description or ''"/>
            </div>
        </field>
    </record>

    <record id="mail_template_hr_case_assigned" model="mail.template">
        <field name="name">HR Case: Assigned</field>
        <field name="model_id" ref="model_hr_case"/>
        <field name="subject">HR Case {{ object.name }} has been assigned to you</field>
        <field name="partner_to">{{ object.user_id.partner_id.id or '' }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
            <div style="margin:0;padding:0;">
                <p>Case <strong t-out="object.name or ''"/> has been assigned to you.</p>
                <p t-out="object.short_description or ''"/>
                <p>Will escalate on: <span t-out="object.will_escalate_on or ''"/></p>
            </div>
        </field>
    </record>

    <record id="mail_template_hr_case_sla_breach" model="mail.template">
        <field name="name">HR Case: SLA Breach Escalation</field>
        <field name="model_id" ref="model_hr_case"/>
        <field name="subject">⚠ SLA Breached on HR Case {{ object.name }}</field>
        <field name="partner_to">{{ object.user_id.partner_id.id or '' }}</field>
        <field name="email_to">{{ object.team_id.notification_email or '' }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
            <div style="margin:0;padding:0;">
                <p style="color:#d9534f;"><strong>SLA breached</strong> on case
                   <span t-out="object.name or ''"/>.</p>
                <p>Escalation count: <span t-out="object.escalation_counter"/></p>
                <p t-out="object.short_description or ''"/>
            </div>
        </field>
    </record>
</odoo>
