<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- New categories used by the India: Regular Pay structure -->
        <!-- No longer used by any active rule (CCA and HRA were merged
             into hr_rule_in_hra below), but kept - not deleted - because
             historical hr.payslip.line rows from before the merge still
             hold a foreign key to it. -->
        <record id="CCA" model="hr.salary.rule.category">
            <field name="name">City Compensatory Allowance</field>
            <field name="code">CCA</field>
            <field name="parent_id" ref="hr_payroll_community.ALW"/>
        </record>
        <record id="PROJALW" model="hr.salary.rule.category">
            <field name="name">Project &amp; Special Allowance</field>
            <field name="code">PROJALW</field>
            <field name="parent_id" ref="hr_payroll_community.ALW"/>
        </record>
        <record id="BONUS_CAT" model="hr.salary.rule.category">
            <field name="name">Bonus</field>
            <field name="code">BONUS</field>
            <field name="parent_id" ref="hr_payroll_community.ALW"/>
        </record>
        <record id="INFO" model="hr.salary.rule.category">
            <field name="name">Info (not on payslip)</field>
            <field name="code">INFO</field>
        </record>
        <record id="CTC_CAT" model="hr.salary.rule.category">
            <field name="name">Total CTC</field>
            <field name="code">CTC</field>
        </record>

        <!-- Basic: a plain amount the admin types on the employee's
             Payroll tab (no more Wage/percentage math behind it - that
             turned out fragile), pro-rated by days actually paid
             (timesheet attendance + paid leave) over scheduled working
             days in the period. -->
        <record id="hr_rule_in_basic" model="hr.salary.rule">
            <field name="name">Basic Salary</field>
            <field name="sequence" eval="1"/>
            <field name="code">BASIC</field>
            <field name="category_id" ref="hr_payroll_community.BASIC"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">WORKING_HOURS = worked_days.dict['WORKING_DAYS'].number_of_hours if 'WORKING_DAYS' in worked_days.dict else 0.0
PAID_HOURS = worked_days.dict['PAID_DAYS'].number_of_hours if 'PAID_DAYS' in worked_days.dict else 0.0
ratio = (PAID_HOURS / WORKING_HOURS) if WORKING_HOURS else 0.0
result = inputs.dict['BASIC_ADJ'].amount if 'BASIC_ADJ' in inputs.dict else contract.basic_amount * ratio</field>
            <field name="note">Basic Salary x (Paid Hours / Working Hours). Pro-rated by hours, not days, so editing the Hours column on a worked-days line actually changes pay. Manually edited on a payslip (New Payslip wizard) via the BASIC_ADJ input, which takes over from the formula whenever it's present.</field>
        </record>

        <!-- Retired: was a hidden helper capping EPF contributions at a
             statutory wage ceiling for rate-based EPF computation. EPF
             amounts are now plain entered amounts (see hr_rule_in_epf_ee
             etc. below), so there's no rate/ceiling left to apply this
             to. Kept, not deleted, in case any historical payslip.line
             still holds a foreign key to it - not referenced in
             rule_ids below, so it never fires on new payslips. -->
        <record id="hr_rule_in_epf_base" model="hr.salary.rule">
            <field name="name">EPF Contribution Base (hidden)</field>
            <field name="sequence" eval="5"/>
            <field name="code">EPF_BASE</field>
            <field name="category_id" ref="INFO"/>
            <field name="appears_on_payslip" eval="False"/>
            <field name="active" eval="False"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = 0.0</field>
        </record>

        <!-- Formerly two separate rules (House Rent Allowance / City
             Compensatory Allowance). Merged into this one rule, keeping
             the ORIGINAL "hr_rule_in_hra" external id and repurposing
             its fields in place rather than deleting/recreating it -
             historical hr.payslip.line rows hold a foreign key to this
             record's database id, and unlinking it during a module
             upgrade would fail with a constraint violation. Payslips
             computed before the merge keep their own stored "House Rent
             Allowance" name/code snapshot regardless of this rename;
             only newly computed payslips see the merged name/formula.
             hr_rule_in_cca (below in this same concern) is retired the
             same way - kept, not deleted, and no longer in rule_ids. -->
        <record id="hr_rule_in_hra" model="hr.salary.rule">
            <field name="name">City Compensatory Allowance + HRA</field>
            <field name="sequence" eval="10"/>
            <field name="code">HRACCA</field>
            <field name="category_id" ref="hr_payroll_community.HRA"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">WORKING_HOURS = worked_days.dict['WORKING_DAYS'].number_of_hours if 'WORKING_DAYS' in worked_days.dict else 0.0
PAID_HOURS = worked_days.dict['PAID_DAYS'].number_of_hours if 'PAID_DAYS' in worked_days.dict else 0.0
ratio = (PAID_HOURS / WORKING_HOURS) if WORKING_HOURS else 0.0
result = inputs.dict['HRACCA_ADJ'].amount if 'HRACCA_ADJ' in inputs.dict else contract.hra_cca_amount * ratio</field>
        </record>

        <!-- Retired (folded into hr_rule_in_hra above) - kept only so
             historical payslip lines from before the merge keep a valid
             foreign key. Not referenced in rule_ids below, so it never
             fires on new payslips. -->
        <record id="hr_rule_in_cca" model="hr.salary.rule">
            <field name="name">City Compensatory Allowance</field>
            <field name="sequence" eval="11"/>
            <field name="code">CCA</field>
            <field name="category_id" ref="CCA"/>
            <field name="active" eval="False"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = 0.0</field>
        </record>

        <record id="hr_rule_in_medical" model="hr.salary.rule">
            <field name="name">Medical Allowance</field>
            <field name="sequence" eval="12"/>
            <field name="code">MEDICAL</field>
            <field name="category_id" ref="hr_payroll_community.Medical"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">WORKING_HOURS = worked_days.dict['WORKING_DAYS'].number_of_hours if 'WORKING_DAYS' in worked_days.dict else 0.0
PAID_HOURS = worked_days.dict['PAID_DAYS'].number_of_hours if 'PAID_DAYS' in worked_days.dict else 0.0
ratio = (PAID_HOURS / WORKING_HOURS) if WORKING_HOURS else 0.0
result = inputs.dict['MEDICAL_ADJ'].amount if 'MEDICAL_ADJ' in inputs.dict else contract.medical_allowance * ratio</field>
        </record>

        <record id="hr_rule_in_projalw" model="hr.salary.rule">
            <field name="name">Project and Special Allowance</field>
            <field name="sequence" eval="15"/>
            <field name="code">PROJALW</field>
            <field name="category_id" ref="PROJALW"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">WORKING_HOURS = worked_days.dict['WORKING_DAYS'].number_of_hours if 'WORKING_DAYS' in worked_days.dict else 0.0
PAID_HOURS = worked_days.dict['PAID_DAYS'].number_of_hours if 'PAID_DAYS' in worked_days.dict else 0.0
ratio = (PAID_HOURS / WORKING_HOURS) if WORKING_HOURS else 0.0
result = inputs.dict['PROJALW_ADJ'].amount if 'PROJALW_ADJ' in inputs.dict else contract.project_allowance_amount * ratio</field>
        </record>

        <record id="hr_rule_in_bonus" model="hr.salary.rule">
            <field name="name">Bonus if any</field>
            <field name="sequence" eval="16"/>
            <field name="code">BONUSAMT</field>
            <field name="category_id" ref="BONUS_CAT"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = inputs.dict['BONUS'].amount if 'BONUS' in inputs.dict else 0.0</field>
        </record>
        <record id="input_bonus" model="hr.rule.input">
            <field name="name">Bonus if any</field>
            <field name="code">BONUS</field>
            <field name="input_id" ref="hr_rule_in_bonus"/>
        </record>

        <!-- Ad-hoc extra earning lines added from the New Payslip wizard
             ("+ Add Earning"). Each such line is stored as its own
             hr.payslip.input with a unique EXTRAEARN_* code (so the
             wizard can show/edit/remove them individually); this single
             rule sums them all into one payslip line that folds into
             Gross/CTC like any other allowance. Only appears on the
             payslip when at least one such line actually exists. -->
        <record id="hr_rule_in_other_earnings" model="hr.salary.rule">
            <field name="name">Other Earnings</field>
            <field name="sequence" eval="17"/>
            <field name="code">OTHERERN</field>
            <field name="category_id" ref="hr_payroll_community.ALW"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = any(code.startswith('EXTRAEARN') for code in inputs.dict)</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = sum(inputs.dict[code].amount for code in inputs.dict if code.startswith('EXTRAEARN'))</field>
        </record>

        <!-- Statutory / manual-input deductions -->
        <record id="hr_rule_in_epf_ee" model="hr.salary.rule">
            <field name="name">EPF Employee Deduction</field>
            <field name="sequence" eval="110"/>
            <field name="code">EPF_EE</field>
            <field name="category_id" ref="hr_payroll_community.DED"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = -inputs.dict['EPF_EE_ADJ'].amount if 'EPF_EE_ADJ' in inputs.dict else -contract.epf_employee_amount</field>
        </record>

        <record id="hr_rule_in_lwf_ee" model="hr.salary.rule">
            <field name="name">Labour Welfare Fund (Employee)</field>
            <field name="sequence" eval="111"/>
            <field name="code">LWF_EE</field>
            <field name="category_id" ref="hr_payroll_community.DED"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = -inputs.dict['LWF_EE_ADJ'].amount if 'LWF_EE_ADJ' in inputs.dict else -contract.lwf_employee</field>
        </record>

        <record id="hr_rule_in_tds" model="hr.salary.rule">
            <field name="name">TDS if any</field>
            <field name="sequence" eval="112"/>
            <field name="code">TDSAMT</field>
            <field name="category_id" ref="hr_payroll_community.DED"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = -(inputs.dict['TDS'].amount if 'TDS' in inputs.dict else 0.0)</field>
        </record>
        <record id="input_tds" model="hr.rule.input">
            <field name="name">TDS if any</field>
            <field name="code">TDS</field>
            <field name="input_id" ref="hr_rule_in_tds"/>
        </record>

        <record id="hr_rule_in_addldeduction" model="hr.salary.rule">
            <field name="name">Additional Deductions if any</field>
            <field name="sequence" eval="113"/>
            <field name="code">ADDLDEDAMT</field>
            <field name="category_id" ref="hr_payroll_community.DED"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = -(inputs.dict['ADDLDED'].amount if 'ADDLDED' in inputs.dict else 0.0)</field>
        </record>
        <record id="input_addldeduction" model="hr.rule.input">
            <field name="name">Additional Deductions if any</field>
            <field name="code">ADDLDED</field>
            <field name="input_id" ref="hr_rule_in_addldeduction"/>
        </record>

        <!-- Ad-hoc extra deduction lines added from the New Payslip wizard
             ("+ Add Deduction"), same mechanism as Other Earnings above. -->
        <record id="hr_rule_in_other_deductions" model="hr.salary.rule">
            <field name="name">Other Deductions</field>
            <field name="sequence" eval="114"/>
            <field name="code">OTHERDED</field>
            <field name="category_id" ref="hr_payroll_community.DED"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = any(code.startswith('EXTRADED') for code in inputs.dict)</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = -sum(inputs.dict[code].amount for code in inputs.dict if code.startswith('EXTRADED'))</field>
        </record>

        <!-- Employer/company contributions: part of CTC, not deducted
             from the employee's Net pay. -->
        <record id="hr_rule_in_epf_er" model="hr.salary.rule">
            <field name="name">Company EPF Share</field>
            <field name="sequence" eval="120"/>
            <field name="code">EPF_ER</field>
            <field name="category_id" ref="hr_payroll_community.COMP"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = contract.epf_employer_amount</field>
        </record>

        <record id="hr_rule_in_epf_admin" model="hr.salary.rule">
            <field name="name">EPF Admin / EDLI Charges</field>
            <field name="sequence" eval="121"/>
            <field name="code">EPF_ADMIN</field>
            <field name="category_id" ref="hr_payroll_community.COMP"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = contract.epf_admin_amount</field>
        </record>

        <!-- Retired: the reference salary sheet this structure now
             matches doesn't include an employer-side LWF or a Gratuity
             accrual line in CTC at all (CTC = Total Salary + Company
             EPF Share + EPF Exp, full stop). Both rules, and the
             contract fields they read, are gone; these two records are
             kept (not deleted) only for the same historical-foreign-key
             reason as hr_rule_in_cca above, and are no longer in
             rule_ids so they never fire on new payslips. -->
        <record id="hr_rule_in_lwf_er" model="hr.salary.rule">
            <field name="name">Labour Welfare Fund (Employer)</field>
            <field name="sequence" eval="122"/>
            <field name="code">LWF_ER</field>
            <field name="category_id" ref="hr_payroll_community.COMP"/>
            <field name="active" eval="False"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = 0.0</field>
        </record>

        <record id="hr_rule_in_gratuity" model="hr.salary.rule">
            <field name="name">Gratuity Accrual (hidden)</field>
            <field name="sequence" eval="123"/>
            <field name="code">GRATUITY</field>
            <field name="category_id" ref="hr_payroll_community.COMP"/>
            <field name="appears_on_payslip" eval="False"/>
            <field name="active" eval="False"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = 0.0</field>
        </record>

        <!-- Total CTC = everything earned (incl. bonus) + employer's EPF,
             LWF and Gratuity accrual. Matches "Total Salary + EPF Share +
             EPF Exp + Gratuity + Bonus" definition used on real Indian
             payslips. -->
        <record id="hr_rule_in_ctc" model="hr.salary.rule">
            <field name="name">Total CTC (this period)</field>
            <field name="sequence" eval="210"/>
            <field name="code">CTC</field>
            <field name="category_id" ref="CTC_CAT"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = categories.BASIC + categories.ALW + categories.COMP</field>
        </record>

        <!-- India: Regular Pay structure -->
        <record id="structure_in_regular" model="hr.payroll.structure">
            <field name="code">IN_REGULAR</field>
            <field name="name">India: Regular Pay</field>
            <!-- This structure is self-contained: it already includes its
                 own Basic/Gross/Net rules (some by direct ref to the base
                 module's rules). It must NOT inherit "Base for new
                 structures" as a parent - that structure defines its OWN
                 unconditional Basic/Gross/Net rules with the same codes,
                 which get_all_rules()/_get_parent_structure() would merge
                 in alongside these, double-firing same-code rules and
                 corrupting the category totals used for pro-ration. -->
            <field name="parent_id" eval="False"/>
            <field name="note">Generic, configurable Indian payroll structure: Basic/CCA+HRA/Medical/Project Allowance auto pro-rated from Timesheet Pro attendance and Time Off, with statutory EPF (employee + employer + admin) and Labour Welfare Fund contributions.</field>
            <field eval="[(6, 0, [
                ref('hr_rule_in_basic'),
                ref('hr_rule_in_hra'),
                ref('hr_rule_in_medical'),
                ref('hr_rule_in_projalw'),
                ref('hr_rule_in_bonus'),
                ref('hr_rule_in_other_earnings'),
                ref('hr_payroll_community.hr_rule_taxable'),
                ref('hr_rule_in_epf_ee'),
                ref('hr_rule_in_lwf_ee'),
                ref('hr_rule_in_tds'),
                ref('hr_rule_in_addldeduction'),
                ref('hr_rule_in_other_deductions'),
                ref('hr_rule_in_epf_er'),
                ref('hr_rule_in_epf_admin'),
                ref('hr_payroll_community.hr_rule_net'),
                ref('hr_rule_in_ctc'),
            ])]" name="rule_ids"/>
            <field name="company_id" ref="base.main_company"/>
        </record>
    </data>
</odoo>
