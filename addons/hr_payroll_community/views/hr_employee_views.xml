<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Employee View -->
    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(action_hr_payslip)d"
                        class="oe_stat_button"
                        icon="fa-credit-card"
                        type="action"
                        groups="hr_payroll_community.group_hr_payroll_community_user">
                    <field name="payslip_count" widget="statinfo"
                           string="Payslips"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='structure_type_id']" position="after">
                <field name="struct_id" placeholder="No structure set"
                       groups="hr_payroll_community.group_hr_payroll_community_user"/>
            </xpath>
            <xpath expr="//group[@name='payroll_group']" position="inside">
                <group name="in_regular_breakdown" string="Salary Components (editable - this month's full amount)"
                       groups="hr_payroll_community.group_hr_payroll_community_user">
                    <field name="basic_amount"/>
                    <field name="hra_cca_amount"/>
                    <field name="medical_allowance"/>
                    <field name="project_allowance_amount"/>
                    <separator string="Deductions" colspan="2"/>
                    <field name="epf_employee_amount" string="EPF Deduction (Employee)"/>
                    <field name="lwf_employee" string="LWF Deduction (Employee)"/>
                    <separator string="Total CTC" colspan="2"/>
                    <field name="epf_employer_amount" string="Company EPF Share (12%)"/>
                    <field name="epf_admin_amount" string="EPF Exp (1%) 0.5% EDLI+ 0.5% EPF ADMIN"/>
                    <field name="ctc_amount" readonly="1"/>
                </group>
                <group name="in_statutory_ids" string="Statutory Identification"
                       groups="hr_payroll_community.group_hr_payroll_community_user">
                    <field name="pan_number"/>
                    <field name="uan_number"/>
                    <field name="lwf_number"/>
                    <field name="employee_sid"/>
                    <field name="pay_mode"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
