<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payslip_pay_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.payslip.pay.wizard.view.form</field>
        <field name="model">hr.payslip.pay.wizard</field>
        <field name="arch" type="xml">
            <form string="Pay Payslip">
                <group>
                    <field name="payslip_ids" widget="many2many_tags" readonly="1"/>
                    <field name="payment_mode" widget="radio"/>
                    <field name="payment_date"/>
                </group>
                <footer>
                    <button string="Mark as Paid" name="action_confirm"
                            type="object" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_hr_payslip_pay_wizard" model="ir.actions.act_window">
        <field name="name">Pay Payslip</field>
        <field name="res_model">hr.payslip.pay.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
