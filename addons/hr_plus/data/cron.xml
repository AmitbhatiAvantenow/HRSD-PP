<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_doc_expiry" model="ir.cron">
            <field name="name">HR Plus: document expiry alerts</field>
            <field name="model_id" ref="model_mn_hr_document_tracker"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_expiries()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_cert_expiry" model="ir.cron">
            <field name="name">HR Plus: certification expiry alerts</field>
            <field name="model_id" ref="model_mn_hr_training"/>
            <field name="state">code</field>
            <field name="code">model._cron_cert_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_probation" model="ir.cron">
            <field name="name">HR Plus: probation review alerts</field>
            <field name="model_id" ref="model_mn_hr_probation"/>
            <field name="state">code</field>
            <field name="code">model._cron_alert_due()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
