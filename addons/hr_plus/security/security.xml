<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="group_hr_plus_user" model="res.groups">
            <field name="name">HR Plus / User</field>
            <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>
        <record id="group_hr_plus_manager" model="res.groups">
            <field name="name">HR Plus / Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_hr_plus_user')),
                                              (4, ref('hr.group_hr_manager'))]"/>
        </record>
    </data>
</odoo>
