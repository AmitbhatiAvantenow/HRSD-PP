<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
<record id="action_trip" model="ir.actions.act_window"><field name="name">Business Trips</field>
<field name="res_model">mn.hr.business.trip</field><field name="view_mode">list,form</field></record>
<record id="view_trip_list" model="ir.ui.view"><field name="name">trip.list</field>
<field name="model">mn.hr.business.trip</field><field name="arch" type="xml">
<list><field name="name"/><field name="employee_id"/><field name="destination_country_id"/><field name="destination_city"/>
<field name="start_date"/><field name="end_date"/><field name="duration_days"/>
<field name="total_cost" widget="monetary"/><field name="currency_id" invisible="1"/>
<field name="state" widget="badge"/></list>
</field></record></data></odoo>
