<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
<record id="view_employee_form_plus" model="ir.ui.view"><field name="name">hr.employee.form.plus</field>
<field name="model">hr.employee</field><field name="inherit_id" ref="hr.view_employee_form"/>
<field name="arch" type="xml">
<xpath expr="//div[hasclass('oe_button_box')]" position="inside">
<button class="oe_stat_button" icon="fa-id-card" type="action" name="%(action_document_tracker)d" context="{'search_default_employee_id': id}">
<field name="document_count" widget="statinfo" string="Documents"/></button>
<button class="oe_stat_button" icon="fa-exclamation-circle" type="action" name="%(action_document_tracker)d" context="{'search_default_employee_id': id}">
<field name="expiring_document_count" widget="statinfo" string="Expiring"/></button>
<button class="oe_stat_button" icon="fa-laptop" type="action" name="%(action_asset)d" context="{'search_default_employee_id': id}">
<field name="active_asset_count" widget="statinfo" string="Assets"/></button>
<button class="oe_stat_button" icon="fa-users" type="action" name="%(action_dependent)d" context="{'search_default_employee_id': id}">
<field name="dependent_count" widget="statinfo" string="Dependents"/></button>
<button class="oe_stat_button" icon="fa-money-bill" type="action" name="%(action_loan)d" context="{'search_default_employee_id': id}">
<field name="active_loan_count" widget="statinfo" string="Loans"/></button>
<button class="oe_stat_button" icon="fa-gavel" type="action" name="%(action_disciplinary)d" context="{'search_default_employee_id': id}">
<field name="open_disciplinary_count" widget="statinfo" string="Open D-Actions"/></button>
</xpath>
<xpath expr="//notebook" position="inside">
<page string="HR Plus &#8212; Documents">
<group><group string="Identity"><field name="iqama_no"/><field name="iqama_expiry"/><field name="work_permit_no"/><field name="work_permit_expiry"/><field name="insurance_card_no"/><field name="insurance_card_expiry"/></group>
<group string="Other"><field name="blood_type"/></group></group>
<separator string="Document Tracker"/>
<field name="document_tracker_ids"><list><field name="document_type_id"/><field name="document_number"/><field name="expiry_date"/><field name="days_to_expiry"/><field name="state" widget="badge"/></list></field>
</page>
<page string="HR Plus &#8212; Assets">
<field name="asset_assignment_ids"><list><field name="name"/><field name="category_id"/><field name="asset_name"/><field name="assigned_on"/><field name="returned_on"/><field name="state" widget="badge"/></list></field>
</page>
<page string="HR Plus &#8212; Career &amp; Dependents">
<separator string="Career history"/>
<field name="career_history_ids"><list><field name="effective_date"/><field name="change_type" widget="badge"/><field name="new_job_title"/><field name="new_salary" widget="monetary"/><field name="increment_pct"/><field name="currency_id" invisible="1"/></list></field>
<separator string="Dependents"/>
<field name="dependent_ids"><list editable="bottom"><field name="name"/><field name="relation" widget="badge"/><field name="gender"/><field name="date_of_birth"/><field name="nationality_id"/><field name="passport_no"/><field name="passport_expiry"/><field name="eligible_allowance" widget="boolean_toggle"/></list></field>
</page>
</xpath></field></record></data></odoo>
