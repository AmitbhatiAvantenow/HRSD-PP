<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
<record id="action_disciplinary" model="ir.actions.act_window"><field name="name">Disciplinary Actions</field>
<field name="res_model">mn.hr.disciplinary.action</field><field name="view_mode">list,form</field></record>
<record id="view_dis_list" model="ir.ui.view"><field name="name">dis.list</field>
<field name="model">mn.hr.disciplinary.action</field><field name="arch" type="xml">
<list decoration-danger="action_type in ('termination','final_warning')" decoration-warning="action_type=='written_warning'">
<field name="name"/><field name="employee_id"/><field name="incident_date"/>
<field name="action_type" widget="badge"/><field name="severity" widget="badge"/>
<field name="employee_acknowledged" widget="boolean_toggle"/><field name="state" widget="badge"/></list>
</field></record></data></odoo>
