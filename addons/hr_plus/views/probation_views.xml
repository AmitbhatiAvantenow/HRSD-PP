<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
<record id="action_probation" model="ir.actions.act_window"><field name="name">Probation Tracking</field>
<field name="res_model">mn.hr.probation</field><field name="view_mode">list,form</field><field name="path">probation</field></record>
<record id="view_prob_list" model="ir.ui.view"><field name="name">prob.list</field>
<field name="model">mn.hr.probation</field><field name="arch" type="xml">
<list decoration-warning="state=='review_due'" decoration-success="state=='confirmed'" decoration-danger="state=='failed'">
<field name="employee_id"/><field name="start_date"/><field name="end_date"/><field name="extended_to" optional="show"/>
<field name="duration_months"/><field name="days_remaining"/><field name="review_outcome" widget="badge"/>
<field name="state" widget="badge"/></list>
</field></record></data></odoo>
