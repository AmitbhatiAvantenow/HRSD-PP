<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
<record id="action_onboarding" model="ir.actions.act_window"><field name="name">Onboarding Checklists</field>
<field name="res_model">mn.hr.onboarding.checklist</field><field name="view_mode">list,form</field><field name="path">hr-plus-onboarding-checklists</field></record>
<record id="action_onb_template" model="ir.actions.act_window"><field name="name">Onboarding Task Templates</field>
<field name="res_model">mn.hr.onboarding.template</field><field name="view_mode">list,form</field></record>
<record id="view_onb_list" model="ir.ui.view"><field name="name">onb.list</field>
<field name="model">mn.hr.onboarding.checklist</field><field name="arch" type="xml">
<list decoration-info="state=='in_progress'" decoration-success="state=='done'">
<field name="employee_id"/><field name="start_date"/><field name="target_complete_date"/>
<field name="progress_pct" widget="progressbar"/><field name="state" widget="badge"/></list>
</field></record>
<record id="view_onb_form" model="ir.ui.view"><field name="name">onb.form</field>
<field name="model">mn.hr.onboarding.checklist</field><field name="arch" type="xml">
<form><header><button name="action_generate_tasks" type="object" string="Generate tasks from templates" class="oe_highlight"/></header>
<sheet><group><group><field name="employee_id"/><field name="start_date"/><field name="target_complete_date"/></group>
<group><field name="progress_pct" widget="progressbar"/><field name="state" widget="badge"/></group></group>
<field name="task_ids"><list editable="bottom" decoration-success="state=='done'">
<field name="name"/><field name="department" widget="badge"/><field name="due_date"/>
<field name="assigned_user_id"/><field name="state" widget="badge"/>
<button name="action_done" type="object" string="Done" icon="fa-check" invisible="state=='done'"/></list></field>
</sheet><chatter/></form>
</field></record></data></odoo>
