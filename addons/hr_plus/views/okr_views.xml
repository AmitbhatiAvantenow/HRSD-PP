<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
<record id="action_okr" model="ir.actions.act_window"><field name="name">OKRs</field>
<field name="res_model">mn.hr.okr</field><field name="view_mode">list,form</field></record>
<record id="view_okr_list" model="ir.ui.view"><field name="name">okr.list</field>
<field name="model">mn.hr.okr</field><field name="arch" type="xml">
<list decoration-info="state=='active'" decoration-success="state=='achieved'" decoration-danger="state=='missed'">
<field name="name"/><field name="employee_id"/><field name="period_year"/><field name="period_quarter" widget="badge"/>
<field name="progress_pct" widget="progressbar"/><field name="final_score"/><field name="state" widget="badge"/></list>
</field></record>
<record id="view_okr_form" model="ir.ui.view"><field name="name">okr.form</field>
<field name="model">mn.hr.okr</field><field name="arch" type="xml">
<form><sheet><h1><field name="name"/></h1>
<group><group><field name="employee_id"/><field name="manager_id" readonly="1"/><field name="period_year"/><field name="period_quarter"/></group>
<group><field name="progress_pct" widget="progressbar"/><field name="self_score"/><field name="manager_score"/><field name="final_score" readonly="1"/><field name="weight"/></group></group>
<field name="description"/>
<separator string="Key Results"/>
<field name="key_result_ids"><list editable="bottom">
<field name="sequence" widget="handle"/><field name="name"/><field name="target_value"/>
<field name="current_value"/><field name="unit"/><field name="progress_pct" widget="progressbar"/></list></field>
<field name="notes"/></sheet><chatter/></form>
</field></record></data></odoo>
