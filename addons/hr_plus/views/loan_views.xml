<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
<record id="action_loan" model="ir.actions.act_window"><field name="name">Employee Loans</field>
<field name="res_model">mn.hr.loan</field><field name="view_mode">list,form</field></record>
<record id="action_loan_inst" model="ir.actions.act_window"><field name="name">Loan Installments</field>
<field name="res_model">mn.hr.loan.installment</field><field name="view_mode">list</field></record>
<record id="view_loan_list" model="ir.ui.view"><field name="name">loan.list</field>
<field name="model">mn.hr.loan</field><field name="arch" type="xml">
<list decoration-info="state in ('draft','submitted')" decoration-success="state=='paid'" decoration-warning="state in ('active','disbursed')">
<field name="name"/><field name="employee_id"/><field name="request_date"/><field name="purpose" widget="badge"/>
<field name="principal" widget="monetary"/><field name="months"/><field name="monthly_amount" widget="monetary"/>
<field name="paid_amount" widget="monetary"/><field name="remaining_amount" widget="monetary"/>
<field name="currency_id" invisible="1"/><field name="state" widget="badge"/></list>
</field></record>
<record id="view_loan_form" model="ir.ui.view"><field name="name">loan.form</field>
<field name="model">mn.hr.loan</field><field name="arch" type="xml">
<form><header><button name="action_submit" type="object" string="Submit" class="oe_highlight" invisible="state!='draft'"/>
<button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="state!='submitted'"/>
<button name="action_reject" type="object" string="Reject" invisible="state!='submitted'"/>
<button name="action_disburse" type="object" string="Disburse" class="oe_highlight" invisible="state!='approved'"/>
<field name="state" widget="statusbar"/></header>
<sheet><h1><field name="name"/></h1>
<group><group><field name="employee_id"/><field name="request_date"/><field name="purpose"/><field name="approved_by_id" readonly="1"/></group>
<group><field name="principal"/><field name="interest_pct"/><field name="months"/><field name="start_date"/>
<field name="monthly_amount" readonly="1"/><field name="total_repayment" readonly="1"/>
<field name="paid_amount" readonly="1"/><field name="remaining_amount" readonly="1"/>
<field name="currency_id"/></group></group>
<field name="description"/>
<notebook><page string="Installments"><field name="installment_ids"><list decoration-danger="state=='overdue'" decoration-success="state=='paid'">
<field name="sequence"/><field name="due_date"/><field name="amount" widget="monetary"/>
<field name="paid_amount" widget="monetary"/><field name="paid_on"/><field name="state" widget="badge"/>
<field name="currency_id" invisible="1"/>
<button name="action_mark_paid" type="object" string="Mark paid" icon="fa-check" invisible="state=='paid'"/></list></field></page></notebook>
</sheet><chatter/></form>
</field></record></data></odoo>
