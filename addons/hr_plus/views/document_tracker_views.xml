<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
<record id="action_document_tracker" model="ir.actions.act_window"><field name="name">Document Tracker</field>
<field name="res_model">mn.hr.document.tracker</field><field name="view_mode">list,form</field></record>
<record id="action_document_type" model="ir.actions.act_window"><field name="name">Document Types</field>
<field name="res_model">mn.hr.document.type</field><field name="view_mode">list,form</field></record>
<record id="view_doctype_list" model="ir.ui.view"><field name="name">doctype.list</field>
<field name="model">mn.hr.document.type</field><field name="arch" type="xml">
<list><field name="sequence" widget="handle"/><field name="name"/><field name="name_ar"/><field name="code"/><field name="notice_days"/><field name="active" widget="boolean_toggle"/></list>
</field></record>
<record id="view_doc_list" model="ir.ui.view"><field name="name">doc.list</field>
<field name="model">mn.hr.document.tracker</field><field name="arch" type="xml">
<list decoration-danger="state=='expired'" decoration-warning="state=='critical'" decoration-info="state=='warning'" decoration-success="state=='valid'">
<field name="employee_id"/><field name="document_type_id" widget="badge"/><field name="document_number"/>
<field name="issue_date"/><field name="expiry_date"/><field name="days_to_expiry"/>
<field name="country_id" optional="show"/><field name="state" widget="badge"/></list>
</field></record>
<record id="view_doc_form" model="ir.ui.view"><field name="name">doc.form</field>
<field name="model">mn.hr.document.tracker</field><field name="arch" type="xml">
<form><sheet><group><group><field name="employee_id"/><field name="document_type_id"/><field name="document_number"/><field name="country_id"/></group>
<group><field name="issue_date"/><field name="expiry_date"/><field name="days_to_expiry" readonly="1"/><field name="state" readonly="1" widget="badge"/></group></group>
<field name="document_file" widget="binary" filename="document_filename"/><field name="notes"/></sheet><chatter/></form>
</field></record></data></odoo>
