<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <data>

        <record id="demo_htp_dep_eng" model="hr.department">
            <field name="name">Engineering</field>
        </record>

        <record id="demo_htp_emp_john" model="hr.employee">
            <field name="name">John Carter</field>
            <field name="job_title">UI/UX Designer</field>
            <field name="department_id" ref="demo_htp_dep_eng"/>
        </record>
        <record id="demo_htp_emp_olivia" model="hr.employee">
            <field name="name">Olivia Brown</field>
            <field name="job_title">Frontend Developer</field>
            <field name="department_id" ref="demo_htp_dep_eng"/>
        </record>
        <record id="demo_htp_emp_liam" model="hr.employee">
            <field name="name">Liam Wilson</field>
            <field name="job_title">Backend Developer</field>
            <field name="department_id" ref="demo_htp_dep_eng"/>
        </record>
        <record id="demo_htp_emp_emma" model="hr.employee">
            <field name="name">Emma Davis</field>
            <field name="job_title">QA Engineer</field>
            <field name="department_id" ref="demo_htp_dep_eng"/>
        </record>

        <record id="demo_htp_project" model="project.project">
            <field name="name">Website Redesign</field>
        </record>

        <!-- John: current week, draft -->
        <record id="demo_htp_sheet_john_current" model="hr.timesheet.sheet">
            <field name="employee_id" ref="demo_htp_emp_john"/>
            <field name="project_id" ref="demo_htp_project"/>
            <field name="date_start" eval="(DateTime.today() - timedelta(days=DateTime.today().weekday())).strftime('%Y-%m-%d')"/>
            <field name="date_end" eval="(DateTime.today() - timedelta(days=DateTime.today().weekday()) + timedelta(days=6)).strftime('%Y-%m-%d')"/>
            <field name="state">draft</field>
        </record>
        <record id="demo_htp_line_john_mon" model="hr.timesheet.line">
            <field name="sheet_id" ref="demo_htp_sheet_john_current"/>
            <field name="date" eval="(DateTime.today() - timedelta(days=DateTime.today().weekday())).strftime('%Y-%m-%d')"/>
            <field name="start_time">9.0</field>
            <field name="end_time">18.0</field>
            <field name="hours">8.0</field>
            <field name="comments">UI design for dashboard</field>
        </record>
        <record id="demo_htp_line_john_tue" model="hr.timesheet.line">
            <field name="sheet_id" ref="demo_htp_sheet_john_current"/>
            <field name="date" eval="(DateTime.today() - timedelta(days=DateTime.today().weekday()) + timedelta(days=1)).strftime('%Y-%m-%d')"/>
            <field name="start_time">9.0</field>
            <field name="end_time">18.0</field>
            <field name="hours">8.0</field>
            <field name="comments">Component development</field>
        </record>

        <!-- Olivia, Liam, Emma: last week, submitted (pending approval) -->
        <record id="demo_htp_sheet_olivia" model="hr.timesheet.sheet">
            <field name="employee_id" ref="demo_htp_emp_olivia"/>
            <field name="project_id" ref="demo_htp_project"/>
            <field name="date_start" eval="(DateTime.today() - timedelta(days=DateTime.today().weekday()+7)).strftime('%Y-%m-%d')"/>
            <field name="date_end" eval="(DateTime.today() - timedelta(days=DateTime.today().weekday()+1)).strftime('%Y-%m-%d')"/>
            <field name="state">submitted</field>
            <field name="submitted_date" eval="DateTime.today()"/>
        </record>
        <record id="demo_htp_line_olivia" model="hr.timesheet.line">
            <field name="sheet_id" ref="demo_htp_sheet_olivia"/>
            <field name="date" eval="(DateTime.today() - timedelta(days=DateTime.today().weekday()+7)).strftime('%Y-%m-%d')"/>
            <field name="start_time">9.0</field>
            <field name="end_time">18.0</field>
            <field name="hours">32.75</field>
            <field name="comments">Website redesign - week total</field>
        </record>

