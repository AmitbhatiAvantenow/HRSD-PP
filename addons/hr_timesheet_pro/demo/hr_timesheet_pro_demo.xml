            <field name="employee_id" ref="demo_htp_emp_olivia"/>
            <field name="project_id" ref="demo_htp_project"/>
            <field name="date_start" eval="(DateTime.today() - timedelta(days=DateTime.today().weekday()+14)).strftime('%Y-%m-%d')"/>
