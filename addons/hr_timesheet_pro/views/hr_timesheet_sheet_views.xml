<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== FORM ==================== -->
    <record id="view_hr_timesheet_sheet_form" model="ir.ui.view">
        <field name="name">hr.timesheet.sheet.form</field>
        <field name="model">hr.timesheet.sheet</field>
        <field name="arch" type="xml">
            <form class="htp-form">
                <header>
                    <button name="action_submit" type="object" string="Submit Timesheet"
                            class="btn-primary" icon="fa-paper-plane"
                            invisible="state not in ('draft', 'returned')"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" icon="fa-check"
                            invisible="state != 'submitted'"
                            groups="hr_timesheet_pro.group_timesheet_pro_manager"/>
                    <button name="action_return" type="object" string="Return"
                            icon="fa-undo"
                            invisible="state != 'submitted'"
                            groups="hr_timesheet_pro.group_timesheet_pro_manager"/>
                    <button name="action_reject" type="object" string="Reject"
                            icon="fa-times"
                            invisible="state != 'submitted'"
                            groups="hr_timesheet_pro.group_timesheet_pro_manager"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('rejected', 'returned')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not manager_comment or state not in ('rejected', 'returned')">
                        <strong>Reviewer comment:</strong> <field name="manager_comment" readonly="1" nolabel="1" class="d-inline"/>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" widget="many2one_avatar_user" required="1"
                                   readonly="state not in ('draft',)"/>
                            <field name="job_title" readonly="1"/>
                            <field name="date_start" string="Select Date" widget="monday_date" readonly="state not in ('draft', 'returned')"/>
                            <field name="date_end" readonly="1"/>
                        </group>
                        <group>
                            <field name="week_number"/>
                            <field name="project_id" readonly="state not in ('draft', 'returned')"/>
                            <field name="total_hours" widget="progressbar" string="Total Efforts of the Week"
                                   options="{'current_value': 'total_hours', 'max_value': 'target_hours', 'editable': false}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Timesheet Efforts" name="lines">
                            <div class="d-flex justify-content-end mb-2">
                                <button name="action_copy_last_week" type="object" string="Copy Last Week"
                                        class="btn btn-secondary btn-sm"
                                        invisible="state not in ('draft', 'returned')"/>
                            </div>
                            <field name="line_ids" readonly="state not in ('draft', 'returned')">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="day_name" readonly="1"/>
                                    <field name="start_time" widget="float_time"/>
                                    <field name="end_time" widget="float_time"/>
                                    <field name="hours" widget="float_time" sum="Total"/>
                                    <field name="task_id" optional="hide"/>
                                    <field name="comments" required="billable"/>
                                    <field name="billable"/>
                                </list>
                            </field>
                        </page>
                        <page string="Comments" name="comments">
                            <field name="comments" placeholder="Any additional context for this timesheet..."/>
                        </page>
                    </notebook>
                    <group class="mt-3">
                        <group>
                            <field name="billable_hours"/>
                            <field name="non_billable_hours"/>
                        </group>
                        <group>
                            <field name="overtime_hours"/>
                            <field name="submitted_date" readonly="1" invisible="not submitted_date"/>
                            <field name="approver_id" readonly="1" invisible="not approver_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ==================== LIST ==================== -->
    <record id="view_hr_timesheet_sheet_list" model="ir.ui.view">
        <field name="name">hr.timesheet.sheet.list</field>
        <field name="model">hr.timesheet.sheet</field>
        <field name="arch" type="xml">
            <list string="Timesheets" class="htp-list"
                  decoration-success="state == 'approved'"
                  decoration-warning="state == 'submitted'"
                  decoration-danger="state == 'rejected'"
                  decoration-info="state == 'returned'"
                  decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="employee_id" widget="many2one_avatar_user"/>
                <field name="department_id" optional="hide"/>
                <field name="week_number"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="project_id" optional="show"/>
                <field name="total_hours" widget="float_time" sum="Total"/>
                <field name="billable_percent" string="Billable %" optional="hide" widget="percentage"/>
                <field name="submitted_date" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-warning="state == 'submitted'"
                       decoration-danger="state == 'rejected'"
                       decoration-info="state == 'returned'"/>
            </list>
        </field>
    </record>

    <!-- ==================== KANBAN (Approvals) ==================== -->
    <record id="view_hr_timesheet_sheet_kanban" model="ir.ui.view">
        <field name="name">hr.timesheet.sheet.kanban</field>
        <field name="model">hr.timesheet.sheet</field>
        <field name="arch" type="xml">
            <kanban class="htp-kanban o_kanban_small_column" default_group_by="state" records_draggable="0">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="htp-kanban-card">
                            <div class="d-flex align-items-center mb-2">
                                <field name="employee_id" widget="many2one_avatar_user"/>
                            </div>
                            <div class="fw-bold"><field name="name"/></div>
                            <div class="text-muted small"><field name="week_number"/></div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span><i class="fa fa-clock-o me-1" title="Total Hours"/><field name="total_hours" widget="float_time"/></span>
                                <field name="state" widget="badge"
                                       decoration-success="state == 'approved'"
                                       decoration-warning="state == 'submitted'"
                                       decoration-danger="state == 'rejected'"
                                       decoration-info="state == 'returned'"/>
                            </div>
                            <div class="htp-kanban-actions mt-2" groups="hr_timesheet_pro.group_timesheet_pro_manager"
                                 t-if="record.state.raw_value == 'submitted'">
                                <button name="action_approve" type="object" class="btn btn-sm btn-success me-1">Approve</button>
                                <button name="action_return" type="object" class="btn btn-sm btn-outline-secondary me-1">Return</button>
                                <button name="action_reject" type="object" class="btn btn-sm btn-outline-danger">Reject</button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ==================== CALENDAR ==================== -->
    <record id="view_hr_timesheet_sheet_calendar" model="ir.ui.view">
        <field name="name">hr.timesheet.sheet.calendar</field>
        <field name="model">hr.timesheet.sheet</field>
        <field name="arch" type="xml">
            <calendar string="Timesheets" date_start="date_start" date_stop="date_end"
                      color="employee_id" mode="month" event_limit="5">
                <field name="employee_id" filters="1" avatar_field="avatar_128"/>
                <field name="total_hours"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- ==================== SEARCH ==================== -->
    <record id="view_hr_timesheet_sheet_search" model="ir.ui.view">
        <field name="name">hr.timesheet.sheet.search</field>
        <field name="model">hr.timesheet.sheet</field>
        <field name="arch" type="xml">
            <search string="Search Timesheets">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="project_id"/>
                <separator/>
                <filter string="My Timesheets" name="mine" domain="[('employee_id.user_id', '=', uid)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <filter string="Returned" name="returned" domain="[('state', '=', 'returned')]"/>
                <separator/>
                <filter string="This Month" name="this_month"
                        domain="[('date_start', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <group>
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ==================== ACTIONS ==================== -->
    <record id="action_hr_timesheet_pro_my" model="ir.actions.act_window">
        <field name="name">My Timesheets</field>
        <field name="res_model">hr.timesheet.sheet</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="search_view_id" ref="view_hr_timesheet_sheet_search"/>
        <field name="context">{'search_default_mine': 1}</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">No timesheets yet — create your first weekly timesheet!</p></field>
    </record>

    <record id="action_hr_timesheet_pro_weekly" model="ir.actions.server">
        <field name="name">Weekly Timesheet</field>
        <field name="model_id" ref="model_hr_timesheet_sheet"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_current_week()</field>
    </record>

    <record id="action_hr_timesheet_pro_team" model="ir.actions.act_window">
        <field name="name">Team Timesheets</field>
        <field name="res_model">hr.timesheet.sheet</field>
        <field name="view_mode">list,kanban,form,calendar</field>
        <field name="search_view_id" ref="view_hr_timesheet_sheet_search"/>
        <field name="context">{'search_default_group_employee': 1}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">No team timesheets found.</p></field>
    </record>

    <record id="action_hr_timesheet_pro_approvals" model="ir.actions.act_window">
        <field name="name">Approvals</field>
        <field name="res_model">hr.timesheet.sheet</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_hr_timesheet_sheet_search"/>
        <field name="context">{'search_default_submitted': 1}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Nothing pending approval right now.</p></field>
    </record>

    <record id="action_hr_timesheet_pro_calendar" model="ir.actions.act_window">
        <field name="name">Calendar View</field>
        <field name="res_model">hr.timesheet.sheet</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="search_view_id" ref="view_hr_timesheet_sheet_search"/>
    </record>

</odoo>
