<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_timesheet_pro_company_form" model="ir.ui.view">
        <field name="name">res.company.form.timesheet.pro</field>
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <form string="Timesheet Settings">
                <sheet>
                    <div class="oe_title">
                        <h1>Timesheet Settings</h1>
                    </div>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="timesheet_pro_weekly_target_hours" string="Weekly Target Hours"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_timesheet_pro_settings" model="ir.actions.server">
        <field name="name">Timesheet Settings</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">action = {
    'type': 'ir.actions.act_window',
    'name': 'Timesheet Settings',
    'res_model': 'res.company',
    'view_mode': 'form',
    'views': [(env.ref('hr_timesheet_pro.view_hr_timesheet_pro_company_form').id, 'form')],
    'res_id': env.company.id,
    'target': 'current',
}</field>
    </record>
</odoo>
