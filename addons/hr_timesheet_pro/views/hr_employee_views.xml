<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_timesheet_pro" model="ir.ui.view">
        <field name="name">hr.employee.form.timesheet.pro</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <button name="action_open_versions" position="before">
                <button name="action_open_timesheet_pro"
                        class="oe_stat_button"
                        icon="fa-list-alt"
                        type="object"
                        groups="hr_timesheet_pro.group_timesheet_pro_employee">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Timesheet Pro</span>
                    </div>
                </button>
            </button>
        </field>
    </record>
</odoo>
