<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_hr_timesheet_pro" model="ir.module.category">
        <field name="name">Timesheets Pro</field>
        <field name="sequence">18</field>
    </record>

    <record id="res_groups_privilege_hr_timesheet_pro" model="res.groups.privilege">
        <field name="name">Timesheet Access</field>
        <field name="category_id" ref="module_category_hr_timesheet_pro"/>
    </record>

    <record id="group_timesheet_pro_employee" model="res.groups">
        <field name="name">Employee</field>
        <field name="privilege_id" ref="res_groups_privilege_hr_timesheet_pro"/>
        <field name="sequence">10</field>
        <field name="comment">Can log time and view/submit their own weekly timesheets only. No approval rights.</field>
    </record>

    <record id="group_timesheet_pro_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_hr_timesheet_pro"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_timesheet_pro_employee'))]"/>
        <field name="comment">Can view every employee's timesheets and approve, return or reject them.</field>
        <!-- The Administrator always has full access. -->
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- Every internal user gets baseline Employee access automatically. -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_timesheet_pro_employee'))]"/>
    </record>

    <!-- Existing HR Officers keep their manager-level access under the new group. -->
    <record id="hr.group_hr_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_timesheet_pro_manager'))]"/>
    </record>
</odoo>
