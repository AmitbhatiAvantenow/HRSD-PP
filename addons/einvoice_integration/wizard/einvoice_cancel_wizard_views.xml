<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_einvoice_cancel_wizard_form" model="ir.ui.view">
        <field name="name">einvoice.cancel.wizard.form</field>
        <field name="model">einvoice.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel e-Invoice">
                <div class="alert alert-warning" role="alert">
                    Cancelling an IRN is only allowed by the GST portal within
                    24 hours of generation, and cannot be undone.
                </div>
                <group>
                    <field name="irn" readonly="1"/>
                    <field name="reason" required="1"/>
                    <field name="remarks" required="1" placeholder="e.g. Wrong entry"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Cancel e-Invoice"
                            class="btn-danger" confirm="This cannot be undone. Cancel this e-Invoice?"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
