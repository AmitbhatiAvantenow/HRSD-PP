<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_einvoice_result_wizard_form" model="ir.ui.view">
        <field name="name">einvoice.result.wizard.form</field>
        <field name="model">einvoice.result.wizard</field>
        <field name="arch" type="xml">
            <form string="e-Invoice">
                <div class="text-center mb-3">
                    <i class="fa fa-check-circle text-success" title="Success" style="font-size:2.5em;"/>
                    <h2 class="mt-2"><field name="title" readonly="1" nolabel="1"/></h2>
                </div>
                <div class="row">
                    <div class="col-7">
                        <group>
                            <field name="irn" readonly="1"/>
                            <field name="ack_no" readonly="1"/>
                            <field name="ack_date" readonly="1"/>
                        </group>
                    </div>
                    <div class="col-5 text-center">
                        <field name="qr_image_html" widget="html" nolabel="1"/>
                    </div>
                </div>
                <footer>
                    <button string="Close" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
