<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_einvoice_integration" model="ir.ui.view">
        <field name="name">account.move.form.einvoice.integration</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_generate_einvoice"
                        type="object"
                        string="Generate e-Invoice"
                        class="btn-primary"
                        invisible="move_type not in ('out_invoice', 'out_refund') or state != 'posted' or einvoice_status == 'generated'"/>
                <button name="action_refresh_einvoice_status"
                        type="object"
                        string="Refresh e-Invoice Status"
                        invisible="einvoice_status != 'generated'"/>
                <button name="action_open_einvoice_ewaybill_wizard"
                        type="object"
                        string="Generate E-Way Bill"
                        invisible="einvoice_status != 'generated' or einvoice_ewaybill_no"/>
                <button name="action_open_einvoice_cancel_wizard"
                        type="object"
                        string="Cancel e-Invoice"
                        invisible="einvoice_status != 'generated'"/>
                <field name="einvoice_status" widget="badge"
                       decoration-success="einvoice_status == 'generated'"
                       decoration-danger="einvoice_status == 'cancelled'"
                       decoration-muted="einvoice_status == 'not_generated'"
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
            <page id="invoice_tab" position="after">
                <page id="einvoice_integration_tab"
                      name="einvoice_integration_tab"
                      string="e-Invoice (GST)"
                      invisible="move_type not in ('out_invoice', 'out_refund')">
                    <div class="alert alert-danger" role="alert" invisible="not einvoice_error">
                        <field name="einvoice_error" readonly="1" nolabel="1"/>
                    </div>
                    <group>
                        <group string="IRN Details">
                            <field name="einvoice_status" readonly="1"/>
                            <field name="einvoice_irn" readonly="1"/>
                            <field name="einvoice_ack_no" readonly="1"/>
                            <field name="einvoice_ack_date" readonly="1"/>
                        </group>
                        <group string="QR Code" invisible="not einvoice_signed_qr_code">
                            <field name="einvoice_qr_image_html" widget="html" nolabel="1"/>
                        </group>
                    </group>
                    <group string="Cancellation" invisible="einvoice_status != 'cancelled'">
                        <field name="einvoice_cancel_reason" readonly="1"/>
                        <field name="einvoice_cancel_remarks" readonly="1"/>
                        <field name="einvoice_cancel_date" readonly="1"/>
                    </group>
                    <group string="E-Way Bill" invisible="not einvoice_ewaybill_no">
                        <field name="einvoice_ewaybill_no" readonly="1"/>
                        <field name="einvoice_ewaybill_date" readonly="1"/>
                        <field name="einvoice_ewaybill_valid_upto" readonly="1"/>
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>
