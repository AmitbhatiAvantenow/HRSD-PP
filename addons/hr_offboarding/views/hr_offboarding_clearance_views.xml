<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_offboarding_clearance_list" model="ir.ui.view">
        <field name="name">hr.offboarding.clearance.list</field>
        <field name="model">hr.offboarding.clearance</field>
        <field name="arch" type="xml">
            <list string="Department Clearances">
                <field name="request_id"/>
                <field name="department"/>
                <field name="status" widget="badge" decoration-success="status == 'approved'"
                       decoration-danger="status == 'rejected'" decoration-warning="status == 'needs_action'"
                       decoration-muted="status == 'pending'"/>
                <field name="approver_id"/>
                <field name="signed_date"/>
                <button name="action_approve" type="object" string="Approve" icon="fa-check"
                        invisible="status == 'approved'"/>
                <button name="action_reject" type="object" string="Reject" icon="fa-times"
                        invisible="status == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_hr_offboarding_clearance_kanban" model="ir.ui.view">
        <field name="name">hr.offboarding.clearance.kanban</field>
        <field name="model">hr.offboarding.clearance</field>
        <field name="arch" type="xml">
            <kanban class="hro_clearance_kanban" default_group_by="department">
                <field name="name"/>
                <field name="status"/>
                <field name="request_id"/>
                <field name="approver_id"/>
                <field name="comments"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="hro-card hro-clearance-card hro-clearance-#{record.status.raw_value}">
                            <div class="hro-clearance-body">
                                <div class="hro-clearance-name"><field name="request_id"/></div>
                                <span t-attf-class="hro-badge hro-badge-#{record.status.raw_value}">
                                    <field name="status"/>
                                </span>
                            </div>
                            <div class="hro-clearance-footer">
                                <span t-if="record.approver_id.value"><field name="approver_id"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hr_offboarding_clearance_form" model="ir.ui.view">
        <field name="name">hr.offboarding.clearance.form</field>
        <field name="model">hr.offboarding.clearance</field>
        <field name="arch" type="xml">
            <form string="Department Clearance">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="status == 'approved'"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="status == 'rejected'"/>
                </header>
                <sheet>
                    <group>
                        <field name="request_id"/>
                        <field name="department"/>
                        <field name="status"/>
                        <field name="approver_id"/>
                        <field name="signed_date"/>
                        <field name="comments"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_offboarding_clearance" model="ir.actions.act_window">
        <field name="name">Clearance Center</field>
        <field name="res_model">hr.offboarding.clearance</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
