<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_offboarding_asset_list" model="ir.ui.view">
        <field name="name">hr.offboarding.asset.list</field>
        <field name="model">hr.offboarding.asset</field>
        <field name="arch" type="xml">
            <list string="Asset Returns" editable="bottom">
                <field name="request_id"/>
                <field name="name"/>
                <field name="asset_type"/>
                <field name="serial_number"/>
                <field name="condition"/>
                <field name="status" widget="badge" decoration-success="status == 'returned'"
                       decoration-danger="status in ('damaged', 'lost')" decoration-muted="status == 'pending'"/>
                <field name="return_date"/>
                <field name="replacement_cost"/>
            </list>
        </field>
    </record>

    <record id="view_hr_offboarding_asset_kanban" model="ir.ui.view">
        <field name="name">hr.offboarding.asset.kanban</field>
        <field name="model">hr.offboarding.asset</field>
        <field name="arch" type="xml">
            <kanban class="hro_asset_kanban">
                <field name="name"/>
                <field name="asset_type"/>
                <field name="status"/>
                <field name="serial_number"/>
                <field name="request_id"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="hro-card hro-asset-card hro-asset-#{record.status.raw_value}">
                            <div class="hro-asset-icon">
                                <i class="fa fa-laptop" title="Asset"/>
                            </div>
                            <div class="hro-asset-body">
                                <div class="hro-asset-name"><field name="name"/></div>
                                <div class="hro-asset-owner"><field name="request_id"/></div>
                                <span t-attf-class="hro-badge hro-badge-#{record.status.raw_value}">
                                    <field name="status"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_hr_offboarding_asset" model="ir.actions.act_window">
        <field name="name">Asset Returns</field>
        <field name="res_model">hr.offboarding.asset</field>
        <field name="view_mode">kanban,list</field>
    </record>
</odoo>
