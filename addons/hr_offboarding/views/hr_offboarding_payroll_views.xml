<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_offboarding_payroll_list" model="ir.ui.view">
        <field name="name">hr.offboarding.payroll.list</field>
        <field name="model">hr.offboarding.payroll</field>
        <field name="arch" type="xml">
            <list string="Full &amp; Final Settlements">
                <field name="request_id"/>
                <field name="total_earnings" sum="Total Earnings"/>
                <field name="total_deductions" sum="Total Deductions"/>
                <field name="net_settlement" sum="Net Settlement"/>
                <field name="status" widget="badge" decoration-success="status == 'paid'"
                       decoration-info="status == 'approved'" decoration-warning="status == 'generated'"
                       decoration-muted="status == 'draft'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_hr_offboarding_payroll_form" model="ir.ui.view">
        <field name="name">hr.offboarding.payroll.form</field>
        <field name="model">hr.offboarding.payroll</field>
        <field name="arch" type="xml">
            <form string="Full &amp; Final Settlement">
                <header>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="request_id"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group string="Earnings">
                        <field name="leave_encashment"/>
                        <field name="pending_salary"/>
                        <field name="bonus"/>
                        <field name="incentives"/>
                        <field name="gratuity"/>
                        <field name="total_earnings"/>
                    </group>
                    <group string="Deductions">
                        <field name="loans"/>
                        <field name="recoveries"/>
                        <field name="tax"/>
                        <field name="pf"/>
                        <field name="total_deductions"/>
                    </group>
                    <group string="Net">
                        <field name="net_settlement"/>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_offboarding_payroll" model="ir.actions.act_window">
        <field name="name">Payroll Settlement</field>
        <field name="res_model">hr.offboarding.payroll</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
