<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_offboarding_interview_list" model="ir.ui.view">
        <field name="name">hr.offboarding.interview.list</field>
        <field name="model">hr.offboarding.interview</field>
        <field name="arch" type="xml">
            <list string="Exit Interviews">
                <field name="request_id"/>
                <field name="scheduled_date"/>
                <field name="interviewer_id"/>
                <field name="exit_reason"/>
                <field name="overall_rating"/>
                <field name="status" widget="badge" decoration-success="status == 'completed'"
                       decoration-muted="status == 'skipped'" decoration-info="status == 'scheduled'"/>
            </list>
        </field>
    </record>

    <record id="view_hr_offboarding_interview_form" model="ir.ui.view">
        <field name="name">hr.offboarding.interview.form</field>
        <field name="model">hr.offboarding.interview</field>
        <field name="arch" type="xml">
            <form string="Exit Interview">
                <header>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="request_id"/>
                        <field name="scheduled_date"/>
                        <field name="interviewer_id"/>
                        <field name="anonymous"/>
                    </group>
                    <group string="Questionnaire">
                        <field name="exit_reason"/>
                        <field name="overall_rating"/>
                        <field name="manager_feedback"/>
                        <field name="company_feedback"/>
                        <field name="suggestions"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_offboarding_interview" model="ir.actions.act_window">
        <field name="name">Exit Interviews</field>
        <field name="res_model">hr.offboarding.interview</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
