<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_invoice_extended" model="report.paperformat">
        <field name="name">A4 - Extended Invoice</field>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
        <field name="css_margins" eval="True"/>
    </record>

    <record id="action_report_invoice_extended" model="ir.actions.report">
        <field name="name">Extended Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">invoicing_extended.report_invoice_extended</field>
        <field name="report_file">invoicing_extended.report_invoice_extended</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="paperformat_id" ref="paperformat_invoice_extended"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="domain" eval="[('move_type', 'in', ('out_invoice', 'out_refund'))]"/>
    </record>
</odoo>
