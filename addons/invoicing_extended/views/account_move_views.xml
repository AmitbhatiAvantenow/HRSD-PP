<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_invoicing_extended" model="ir.ui.view">
        <field name="name">account.move.form.invoicing.extended</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <button id="account_invoice_payment_secondary_btn" position="after">
                <button name="%(invoicing_extended.action_report_invoice_extended)d"
                        type="action"
                        string="Extended Invoice"
                        invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </button>
            <page id="invoice_tab" position="after">
                <page id="invoicing_extended_tab"
                      name="invoicing_extended_tab"
                      string="Extended Invoice"
                      invisible="move_type not in ('out_invoice', 'out_refund')">
                    <group>
                        <group string="Layout &amp; Subject">
                            <field name="invoice_layout"/>
                            <field name="invoice_subject" placeholder="e.g. June '26 Services by Abhishek R - Purchase Order #810013986"/>
                            <field name="client_po_number"/>
                            <field name="invoice_reference_hash" readonly="1"/>
                        </group>
                        <group string="Bill To Contact">
                            <field name="kind_attn"/>
                            <field name="cc_details"/>
                        </group>
                    </group>
                    <group string="Consultant / Assignment"
                           invisible="invoice_layout != 'staff_augmentation'">
                        <group>
                            <field name="consultant_name"/>
                            <field name="job_role"/>
                            <field name="service_period"/>
                        </group>
                        <group>
                            <field name="days_worked"/>
                            <field name="hours_per_day"/>
                            <field name="hourly_rate"/>
                            <field name="hours_worked" readonly="1"/>
                        </group>
                    </group>
                    <group string="Deductions" invisible="invoice_layout != 'staff_augmentation'">
                        <group>
                            <field name="ccw_deduction_percent"/>
                            <field name="ccw_deduction_amount" readonly="1"/>
                            <field name="final_assessable_value" readonly="1"/>
                        </group>
                    </group>
                    <group string="Export / Compliance">
                        <group>
                            <field name="is_export_under_lut"/>
                            <field name="lut_arn" invisible="not is_export_under_lut"/>
                            <field name="reverse_charge_applicable"/>
                        </group>
                        <group string="Authorized Signatory">
                            <field name="authorized_signatory_name"/>
                            <field name="authorized_signatory_designation"/>
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>
