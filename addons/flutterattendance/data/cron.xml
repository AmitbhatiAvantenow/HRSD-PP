<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_flutterattendance_reminders" model="ir.cron">
        <field name="name">Flutter Attendance: Send Check-in/Check-out Reminders</field>
        <field name="model_id" ref="model_flutterattendance_notification"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_reminders()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_flutterattendance_flag_missed_checkouts" model="ir.cron">
        <field name="name">Flutter Attendance: Flag Missed Checkouts</field>
        <field name="model_id" ref="model_flutterattendance_attendance"/>
        <field name="state">code</field>
        <field name="code">model._cron_flag_missed_checkouts()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_flutterattendance_attendance_mail" model="ir.cron">
        <field name="name">Flutter Attendance: Send End-of-Day Attendance Mail</field>
        <field name="model_id" ref="model_flutterattendance_attendance_mail"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_daily_attendance_mail()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
