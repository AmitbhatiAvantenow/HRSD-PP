<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_flutterattendance_shift_list" model="ir.ui.view">
        <field name="name">flutterattendance.shift.list</field>
        <field name="model">flutterattendance.shift</field>
        <field name="arch" type="xml">
            <list string="Attendance Shifts">
                <field name="name"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="grace_minutes"/>
                <field name="half_day_hours"/>
                <field name="full_day_hours"/>
                <field name="monday" optional="show" string="Mon"/>
                <field name="tuesday" optional="show" string="Tue"/>
                <field name="wednesday" optional="show" string="Wed"/>
                <field name="thursday" optional="show" string="Thu"/>
                <field name="friday" optional="show" string="Fri"/>
                <field name="saturday" optional="show" string="Sat"/>
                <field name="sunday" optional="show" string="Sun"/>
            </list>
        </field>
    </record>

    <record id="view_flutterattendance_shift_form" model="ir.ui.view">
        <field name="name">flutterattendance.shift.form</field>
        <field name="model">flutterattendance.shift</field>
        <field name="arch" type="xml">
            <form string="Attendance Shift">
                <sheet>
                    <group>
                        <group string="Timing">
                            <field name="name"/>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                            <field name="break_start_time" widget="float_time"/>
                            <field name="break_minutes"/>
                            <field name="grace_minutes"/>
                        </group>
                        <group string="Working Days">
                            <field name="monday"/>
                            <field name="tuesday"/>
                            <field name="wednesday"/>
                            <field name="thursday"/>
                            <field name="friday"/>
                            <field name="saturday"/>
                            <field name="sunday"/>
                        </group>
                    </group>
                    <group string="Day Classification">
                        <field name="half_day_hours"/>
                        <field name="full_day_hours"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_flutterattendance_shift" model="ir.actions.act_window">
        <field name="name">Attendance Shifts</field>
        <field name="res_model">flutterattendance.shift</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
