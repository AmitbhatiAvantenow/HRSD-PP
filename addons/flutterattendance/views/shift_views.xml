<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_flutterattendance_shift_list" model="ir.ui.view">
        <field name="name">flutterattendance.shift.list</field>
        <field name="model">flutterattendance.shift</field>
        <field name="arch" type="xml">
            <list string="Attendance Shifts">
                <field name="name"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="grace_minutes"/>
                <field name="half_day_hours"/>
                <field name="full_day_hours"/>
            </list>
        </field>
    </record>

    <record id="view_flutterattendance_shift_form" model="ir.ui.view">
        <field name="name">flutterattendance.shift.form</field>
        <field name="model">flutterattendance.shift</field>
        <field name="arch" type="xml">
            <form string="Attendance Shift">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="start_time" widget="float_time"/>
                        <field name="end_time" widget="float_time"/>
                        <field name="grace_minutes"/>
                        <field name="half_day_hours"/>
                        <field name="full_day_hours"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_flutterattendance_shift" model="ir.actions.act_window">
        <field name="name">Attendance Shifts</field>
        <field name="res_model">flutterattendance.shift</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
