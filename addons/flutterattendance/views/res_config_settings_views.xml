<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.flutterattendance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='employees_setting_container']" position="inside">
                <setting id="flutterattendance_setting" string="Mobile Attendance"
                         help="Reminder settings for the Flutter mobile attendance app. Geofencing and
                               security checks are under Mobile Attendance &gt; Settings.">
                    <div class="d-flex">
                        <field name="flutterattendance_notifications_enabled" class="ml16"/>
                        <label for="flutterattendance_notifications_enabled" class="o_light_label"/>
                    </div>
                    <div invisible="not flutterattendance_notifications_enabled">
                        <field name="flutterattendance_checkin_reminder_time" widget="float_time"/>
                        <field name="flutterattendance_checkout_reminder_time" widget="float_time"/>
                    </div>
                </setting>
                <setting id="flutterattendance_face_setting" string="Face Recognition"
                         help="Turn the 'Face Recognition' check on under Mobile Attendance &gt; Settings &gt;
                               Security Checks to enforce these.">
                    <field name="flutterattendance_face_similarity_threshold"/>
                    <field name="flutterattendance_face_max_attempts"/>
                </setting>
                <setting id="flutterattendance_status_setting" string="Attendance Status"
                         help="Fine-tune (or add) the Present/Late/Half Day rules under Mobile Attendance &gt;
                               Settings &gt; Status Rules.">
                    <div class="d-flex">
                        <field name="flutterattendance_status_auto_enabled" class="ml16"/>
                        <label for="flutterattendance_status_auto_enabled" class="o_light_label"/>
                    </div>
                    <div class="content-group">
                        <field name="flutterattendance_status_default_code"
                               placeholder="present"
                               string="Default / Fallback Status Code"/>
                    </div>
                    <div class="content-group">
                        <button name="%(action_flutterattendance_status_rule)d" type="action"
                                string="Configure Status Rules &#8594;" class="btn-link"/>
                    </div>
                    <div class="content-group mt8">
                        <button name="action_recompute_attendance_status" type="object"
                                string="Update Existing Records' Status Now" class="btn-secondary"
                                confirm="This recalculates Status on every existing Mobile Attendance record
                                         using the current Status Rules. New check-ins/check-outs already pick
                                         up rule changes automatically - only click this if you also want past
                                         records updated to match."/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
