<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_flutterattendance_attendance_list" model="ir.ui.view">
        <field name="name">flutterattendance.attendance.list</field>
        <field name="model">flutterattendance.attendance</field>
        <field name="arch" type="xml">
            <list string="Mobile Attendance">
                <field name="employee_id"/>
                <field name="attendance_date"/>
                <field name="check_in_time"/>
                <field name="check_out_time"/>
                <field name="working_hours"/>
                <field name="distance_km"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'present'"
                       decoration-warning="status == 'late'"
                       decoration-danger="status == 'half_day' or status == 'missed_checkout'"/>
                <field name="missed_checkout" optional="show"/>
                <field name="remarks" string="Comment" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_flutterattendance_attendance_form" model="ir.ui.view">
        <field name="name">flutterattendance.attendance.form</field>
        <field name="model">flutterattendance.attendance</field>
        <field name="arch" type="xml">
            <form string="Mobile Attendance">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="attendance_date"/>
                            <field name="status"/>
                            <field name="missed_checkout"/>
                            <field name="remarks"/>
                        </group>
                        <group>
                            <field name="check_in_time"/>
                            <field name="check_out_time"/>
                            <field name="working_hours"/>
                            <field name="late_minutes"/>
                            <field name="overtime_hours"/>
                            <field name="distance_km"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Check In">
                            <group>
                                <group>
                                    <field name="checkin_latitude"/>
                                    <field name="checkin_longitude"/>
                                    <field name="checkin_address"/>
                                    <field name="checkin_accuracy"/>
                                    <field name="device_id"/>
                                </group>
                                <group>
                                    <field name="checkin_battery"/>
                                    <field name="checkin_network"/>
                                    <field name="checkin_internet"/>
                                    <field name="checkin_ip_address"/>
                                    <field name="checkin_created_at"/>
                                </group>
                            </group>
                            <field name="checkin_photo" widget="image" class="oe_avatar"/>
                        </page>
                        <page string="Check Out">
                            <group>
                                <field name="checkout_latitude"/>
                                <field name="checkout_longitude"/>
                                <field name="checkout_address"/>
                                <field name="checkout_accuracy"/>
                                <field name="checkout_created_at"/>
                            </group>
                            <field name="checkout_photo" widget="image" class="oe_avatar"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_flutterattendance_attendance" model="ir.actions.act_window">
        <field name="name">Mobile Attendance</field>
        <field name="res_model">flutterattendance.attendance</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
