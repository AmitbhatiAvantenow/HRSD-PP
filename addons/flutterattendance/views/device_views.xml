<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_flutterattendance_device_list" model="ir.ui.view">
        <field name="name">flutterattendance.device.list</field>
        <field name="model">flutterattendance.device</field>
        <field name="arch" type="xml">
            <list string="Mobile Devices">
                <field name="employee_id"/>
                <field name="device_name"/>
                <field name="device_id"/>
                <field name="os_version"/>
                <field name="app_version"/>
                <field name="last_login"/>
                <field name="last_sync"/>
            </list>
        </field>
    </record>

    <record id="view_flutterattendance_device_form" model="ir.ui.view">
        <field name="name">flutterattendance.device.form</field>
        <field name="model">flutterattendance.device</field>
        <field name="arch" type="xml">
            <form string="Mobile Device">
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="device_id"/>
                        <field name="device_name"/>
                        <field name="os_version"/>
                        <field name="app_version"/>
                        <field name="last_login"/>
                        <field name="last_sync"/>
                        <field name="fcm_token"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_flutterattendance_device" model="ir.actions.act_window">
        <field name="name">Mobile Devices</field>
        <field name="res_model">flutterattendance.device</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
