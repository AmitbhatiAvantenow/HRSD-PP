<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_flutterattendance_status_rule_list" model="ir.ui.view">
        <field name="name">flutterattendance.status.rule.list</field>
        <field name="model">flutterattendance.status.rule</field>
        <field name="arch" type="xml">
            <list string="Attendance Status Rules" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="condition"/>
                <field name="min_hours" invisible="condition != 'hours_range'"/>
                <field name="max_hours" invisible="condition != 'hours_range'"/>
                <field name="require_checkout"/>
                <field name="company_id" optional="show" groups="base.group_multi_company"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_flutterattendance_status_rule_form" model="ir.ui.view">
        <field name="name">flutterattendance.status.rule.form</field>
        <field name="model">flutterattendance.status.rule</field>
        <field name="arch" type="xml">
            <form string="Attendance Status Rule">
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. Half Day, Absent, Overtime"/>
                            <field name="code" placeholder="e.g. half_day"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="condition"/>
                            <field name="min_hours" invisible="condition != 'hours_range'"/>
                            <field name="max_hours" invisible="condition != 'hours_range'"
                                   help="0 = no upper bound"/>
                            <field name="require_checkout"/>
                        </group>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_flutterattendance_status_rule" model="ir.actions.act_window">
        <field name="name">Status Rules</field>
        <field name="res_model">flutterattendance.status.rule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define how a mobile attendance record's Status is calculated.
            </p>
            <p>
                Rules are evaluated top to bottom (drag to reorder) — the first one that matches an
                attendance record wins. Add a new rule to introduce a brand new status (e.g. "Absent",
                "Overtime"), or edit the Worked Hours range on an existing one to change when it applies.
                Turn off automatic calculation entirely under Settings &gt; Attendance Status if you only
                want a single fixed status.
            </p>
        </field>
    </record>
</odoo>
