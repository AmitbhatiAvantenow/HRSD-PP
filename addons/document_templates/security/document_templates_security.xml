<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_document_templates" model="ir.module.category">
        <field name="name">Document Templates</field>
        <field name="sequence">21</field>
    </record>

    <record id="res_groups_privilege_document_templates" model="res.groups.privilege">
        <field name="name">Document Templates</field>
        <field name="category_id" ref="module_category_document_templates"/>
    </record>

    <record id="group_document_templates_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_document_templates"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_document_templates_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_document_templates"/>
        <field name="implied_ids" eval="[(4, ref('group_document_templates_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
