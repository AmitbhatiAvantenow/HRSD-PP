<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="document_templates.PreviewDialog">
    <Dialog title="'Preview: ' + (props.templateName or '')" size="'lg'" contentClass="'doc-wizard-dialog'">
        <div class="doc-shell doc-dialog-scope">
            <div class="doc-empty" t-if="state.loading">Building preview…</div>
            <div class="doc-wizard-error" t-elif="state.error"><i class="fa fa-exclamation-triangle"/> <t t-esc="state.error"/></div>
            <iframe t-else="" t-att-src="pdfDataUrl" style="width:100%; height:70vh; border:1px solid var(--doc-line); border-radius:8px;"/>
        </div>
        <t t-set-slot="footer">
            <button class="doc-btn-outline" t-on-click="() => this.close()">Close</button>
        </t>
    </Dialog>
</t>

</templates>
