<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="document_templates.Dashboard">
    <DocShell activeKey="'dashboard'" eyebrow="'Document Templates'" title="'Templates Dashboard'"
              subtitle="'Design once, generate everywhere.'">
        <t t-set-slot="headerActions">
            <button class="doc-btn-primary" t-on-click="() => this.openTemplates()"><i class="fa fa-plus"/> New Template</button>
        </t>

        <div class="doc-kpi-grid">
            <div class="doc-kpi">
                <div class="doc-kpi-label">Total Templates</div>
                <div class="doc-kpi-value"><t t-esc="state.stats.total_templates"/></div>
            </div>
            <div class="doc-kpi doc-c-info">
                <div class="doc-kpi-label">Generated This Month</div>
                <div class="doc-kpi-value"><t t-esc="state.stats.generated_this_month"/></div>
            </div>
            <div class="doc-kpi doc-c-purple">
                <div class="doc-kpi-label">Shared Templates</div>
                <div class="doc-kpi-value"><t t-esc="state.stats.shared_templates"/></div>
            </div>
            <div class="doc-kpi doc-c-warning">
                <div class="doc-kpi-label">Favourite Templates</div>
                <div class="doc-kpi-value"><t t-esc="state.stats.favourite_templates"/></div>
            </div>
            <div class="doc-kpi">
                <div class="doc-kpi-label">Draft Templates</div>
                <div class="doc-kpi-value"><t t-esc="state.stats.draft_templates"/></div>
            </div>
            <div class="doc-kpi doc-c-success">
                <div class="doc-kpi-label">Published</div>
                <div class="doc-kpi-value"><t t-esc="state.stats.published_templates"/></div>
            </div>
        </div>

        <div class="doc-grid" style="grid-template-columns: 1.2fr 1fr;">
            <div class="doc-card">
                <div class="doc-card-title">Most Used Templates</div>
                <t t-if="state.most_used.length">
                    <div class="doc-bar-row" t-foreach="state.most_used" t-as="t_" t-key="t_.id">
                        <div style="display:flex;justify-content:space-between;">
                            <span style="font-weight:600;"><t t-esc="t_.name"/></span>
                            <span style="color:var(--doc-ink-soft);"><t t-esc="t_.usage_count"/></span>
                        </div>
                        <div class="doc-bar-track">
                            <div class="doc-bar-fill" t-attf-style="width: {{ Math.max(4, (t_.usage_count / maxUsage) * 100) }}%;"/>
                        </div>
                    </div>
                </t>
                <div class="doc-empty" t-else="">No templates generated yet.</div>
            </div>

            <div class="doc-card">
                <div class="doc-card-title">Template Categories</div>
                <div style="display:flex; align-items:center; gap:20px;" t-if="state.category_breakdown.length">
                    <div class="doc-ring-wrap">
                        <div class="doc-ring" t-attf-style="{{ categoryRingStyle }}">
                            <span><t t-esc="state.category_breakdown.length"/> cats</span>
                        </div>
                    </div>
                    <div style="flex:1; min-width:0;">
                        <div t-foreach="state.category_breakdown" t-as="cat" t-key="cat.name" class="doc-legend-row"
                             style="display:flex;align-items:center;gap:8px;padding:4px 0;font-size:12.5px;">
                            <span t-attf-style="width:8px;height:8px;border-radius:50%;background:var({{ categoryDotColor(cat_index) }});flex-shrink:0;"/>
                            <span style="flex:1;"><t t-esc="cat.name"/></span>
                            <span style="color:var(--doc-ink-soft);"><t t-esc="cat.count"/></span>
                        </div>
                    </div>
                </div>
                <div class="doc-empty" t-else="">No categorised templates yet.</div>
            </div>
        </div>

        <div class="doc-grid" style="grid-template-columns: 1fr 1fr;">
            <div class="doc-card">
                <div class="doc-card-title">Department Usage</div>
                <div class="doc-vbar-row" t-if="state.by_department.length">
                    <div class="doc-vbar-col" t-foreach="state.by_department" t-as="d" t-key="d.department">
                        <div class="doc-vbar-value"><t t-esc="d.count"/></div>
                        <div class="doc-vbar" t-attf-style="height: {{ Math.max(8, (d.count / maxDeptCount) * 120) }}px;"/>
                        <div class="doc-vbar-label"><t t-esc="d.label"/></div>
                    </div>
                </div>
                <div class="doc-empty" t-else="">No departments in use yet.</div>
            </div>

            <div class="doc-card">
                <div class="doc-card-title">Generated Documents (Last 6 Months)</div>
                <div class="doc-vbar-row" t-if="state.generated_trend.length">
                    <div class="doc-vbar-col" t-foreach="state.generated_trend" t-as="m" t-key="m.month_label + m_index">
                        <div class="doc-vbar-value"><t t-esc="m.count"/></div>
                        <div class="doc-vbar" t-attf-style="height: {{ Math.max(8, (m.count / maxTrendCount) * 120) }}px; background: var(--doc-info);"/>
                        <div class="doc-vbar-label"><t t-esc="m.month_label"/></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="doc-grid" style="grid-template-columns: 1fr 1.2fr;">
            <div class="doc-card">
                <div class="doc-card-title">Approval Status</div>
                <div style="display:flex; flex-wrap:wrap; gap:8px;">
                    <span class="doc-chip" t-attf-class="{{ approvalChipClass(a.state) }}" t-foreach="state.approval_breakdown" t-as="a" t-key="a.state">
                        <t t-esc="a.label"/>: <t t-esc="a.count"/>
                    </span>
                </div>
            </div>

            <div class="doc-card">
                <div class="doc-card-title">Recently Modified</div>
                <table class="doc-table" t-if="state.recently_modified.length">
                    <tbody>
                        <tr t-foreach="state.recently_modified" t-as="r" t-key="r.id">
                            <td style="font-weight:600;"><t t-esc="r.name"/></td>
                            <td style="color:var(--doc-ink-soft);"><t t-esc="r.write_date"/></td>
                            <td><span class="doc-chip" t-attf-class="{{ r.status === 'published' ? 'doc-c-success' : 'doc-c-muted' }}"><t t-esc="r.status"/></span></td>
                        </tr>
                    </tbody>
                </table>
                <div class="doc-empty" t-else="">Nothing modified yet.</div>
            </div>
        </div>
    </DocShell>
</t>

</templates>
