<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- ── List view ──────────────────────────────────────────────────────── -->
    <record id="hr_document_ocr_list_view" model="ir.ui.view">
      <field name="name">hr.document.ocr.list</field>
      <field name="model">hr.document.ocr</field>
      <field name="arch" type="xml">
        <list string="OCR Document Scans" default_order="create_date desc"
              decoration-danger="state == 'error'"
              decoration-success="state == 'done'">
          <field name="name" string="Document"/>
          <field name="document_type" string="Type" widget="badge"/>
          <field name="employee_id" string="Employee"/>
          <field name="page_count" string="Pages"/>
          <field name="word_count" string="Words"/>
          <field name="confidence" string="Confidence (%)"/>
          <field name="state" string="Status" widget="badge"
                 decoration-success="state == 'done'"
                 decoration-danger="state == 'error'"/>
          <field name="scanned_by" string="Scanned By"/>
          <field name="create_date" string="Scanned On" widget="datetime"/>
        </list>
      </field>
    </record>

    <!-- ── Form view ──────────────────────────────────────────────────────── -->
    <record id="hr_document_ocr_form_view" model="ir.ui.view">
      <field name="name">hr.document.ocr.form</field>
      <field name="model">hr.document.ocr</field>
      <field name="arch" type="xml">
        <form string="OCR Document Scan">
          <header>
            <field name="state" widget="statusbar" statusbar_visible="done,error"/>
          </header>
          <sheet>
            <div class="oe_title">
              <label for="name"/>
              <h1><field name="name" placeholder="Document name…"/></h1>
            </div>
            <group>
              <group string="Document Info">
                <field name="document_type"/>
                <field name="employee_id"/>
                <field name="file_name"/>
                <field name="file_size_kb" string="File Size (KB)"/>
                <field name="page_count"/>
                <field name="word_count"/>
                <field name="confidence"/>
              </group>
              <group string="Audit">
                <field name="scanned_by"/>
                <field name="create_date" string="Scanned On"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'error'"/>
                <field name="employee_attachment_id" string="Saved to Employee" readonly="1"/>
              </group>
            </group>
            <notebook>
              <page string="Extracted Text" name="extracted_text">
                <field name="extracted_text" readonly="1"
                       style="font-family: monospace; font-size: 12px; min-height: 300px;"/>
              </page>
              <page string="Smart Fields (JSON)" name="smart_fields">
                <field name="smart_fields" readonly="1"
                       style="font-family: monospace; font-size: 12px; min-height: 200px;"/>
              </page>
              <page string="Notes" name="notes">
                <field name="notes" placeholder="Add any notes about this document…"/>
              </page>
              <page string="Error Details" name="error_details"
                    invisible="state != 'error'">
                <field name="error_message" readonly="1"
                       style="font-family: monospace; color: #991b1b;"/>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <!-- ── Search view ─────────────────────────────────────────────────────── -->
    <record id="hr_document_ocr_search_view" model="ir.ui.view">
      <field name="name">hr.document.ocr.search</field>
      <field name="model">hr.document.ocr</field>
      <field name="arch" type="xml">
        <search string="Search OCR Scans">
          <field name="name" string="Document Name"/>
          <field name="employee_id"/>
          <field name="scanned_by"/>
          <filter name="done"  string="Scanned" domain="[('state','=','done')]"/>
          <filter name="error" string="Errors"  domain="[('state','=','error')]"/>
          <separator/>
          <filter name="my_scans" string="My Scans" domain="[('scanned_by','=',uid)]"/>
          <group>
            <filter name="group_type"     string="Document Type" context="{'group_by': 'document_type'}"/>
            <filter name="group_employee" string="Employee"      context="{'group_by': 'employee_id'}"/>
            <filter name="group_date"     string="Scanned On"    context="{'group_by': 'create_date:month'}"/>
          </group>
        </search>
      </field>
    </record>

    <!-- ── Window action ───────────────────────────────────────────────────── -->
    <record id="action_hr_document_ocr" model="ir.actions.act_window">
      <field name="name">OCR Document Scans</field>
      <field name="res_model">hr.document.ocr</field>
      <field name="view_mode">list,form</field>
      <field name="search_view_id" ref="hr_document_ocr_search_view"/>
      <field name="context">{'search_default_done': 1}</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">No OCR scans yet</p>
        <p>Go to <a href="/hrsd/ocr">OCR Document Scanner</a> to scan your first document.</p>
      </field>
    </record>

    <!-- ── Menu item ───────────────────────────────────────────────────────── -->
    <menuitem id="menu_hrsd_ocr_scans"
              name="OCR Scans"
              parent="menu_hrsd_root"
              action="action_hr_document_ocr"
              sequence="20"/>

  </data>
</odoo>
