<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action: navigates to the server-rendered HR dashboard page -->
    <record id="action_hrsd_dashboard_url" model="ir.actions.act_url">
        <field name="name">HR Dashboard</field>
        <field name="url">/hrsd/dashboard</field>
        <field name="target">self</field>
    </record>

    <!-- Root menu / app icon in the Odoo Apps drawer -->
    <menuitem id="menu_hrsd_root"
              name="HR Portal"
              action="action_hrsd_dashboard_url"
              sequence="5"/>

</odoo>
