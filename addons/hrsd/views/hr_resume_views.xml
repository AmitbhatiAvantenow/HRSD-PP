<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- ── Job Profile List ─────────────────────────────────────────────── -->
    <record id="hr_resume_job_list_view" model="ir.ui.view">
      <field name="name">hr.resume.job.list</field>
      <field name="model">hr.resume.job</field>
      <field name="arch" type="xml">
        <list string="Resume Screening Jobs" default_order="create_date desc">
          <field name="name" string="Job Title"/>
          <field name="min_experience" string="Min Exp (yrs)"/>
          <field name="education_level" string="Min Education"/>
          <field name="candidate_count" string="Candidates"/>
          <field name="top_score" string="Top Score (%)" widget="float" digits="[5,1]"/>
          <field name="created_by" string="Created By"/>
          <field name="create_date" string="Created On" widget="datetime"/>
        </list>
      </field>
    </record>

    <!-- ── Job Profile Form ─────────────────────────────────────────────── -->
    <record id="hr_resume_job_form_view" model="ir.ui.view">
      <field name="name">hr.resume.job.form</field>
      <field name="model">hr.resume.job</field>
      <field name="arch" type="xml">
        <form string="Resume Screening Job">
          <sheet>
            <div class="oe_button_box" name="button_box">
              <button type="object" name="action_view_candidates"
                      class="oe_stat_button" icon="fa-users">
                <field name="candidate_count" string="Candidates" widget="statinfo"/>
              </button>
            </div>
            <div class="oe_title">
              <label for="name"/>
              <h1><field name="name" placeholder="Job Title…"/></h1>
            </div>
            <group>
              <group string="Requirements">
                <field name="min_experience"/>
                <field name="education_level"/>
              </group>
              <group string="Stats">
                <field name="candidate_count" string="Candidates" readonly="1"/>
                <field name="top_score" readonly="1"/>
                <field name="created_by" readonly="1"/>
              </group>
            </group>
            <group>
              <field name="required_skills"  placeholder="Python, SQL, Leadership, …"/>
              <field name="preferred_skills" placeholder="Docker, Kubernetes, …"/>
            </group>
            <group string="Job Description">
              <field name="job_description" placeholder="Paste the full job description here…" nolabel="1"/>
            </group>
            <notebook>
              <page string="Candidates" name="candidates">
                <field name="candidate_ids" readonly="1">
                  <list string="Candidates" default_order="score_overall desc"
                        decoration-success="state == 'shortlisted'"
                        decoration-danger="state == 'rejected'">
                    <field name="rank" string="#"/>
                    <field name="name" string="Candidate"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="experience_years" string="Exp (yrs)"/>
                    <field name="education_level" string="Education"/>
                    <field name="score_overall" string="Score (%)" widget="float" digits="[5,1]"/>
                    <field name="score_skills" string="Skills %"/>
                    <field name="score_experience" string="Exp %"/>
                    <field name="score_education" string="Edu %"/>
                    <field name="score_content" string="Match %"/>
                    <field name="state" string="Status" widget="badge"
                           decoration-success="state == 'shortlisted'"
                           decoration-danger="state == 'rejected'"
                           decoration-warning="state == 'scored'"/>
                  </list>
                </field>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <!-- ── Job Profile Search ───────────────────────────────────────────── -->
    <record id="hr_resume_job_search_view" model="ir.ui.view">
      <field name="name">hr.resume.job.search</field>
      <field name="model">hr.resume.job</field>
      <field name="arch" type="xml">
        <search string="Search Jobs">
          <field name="name" string="Job Title"/>
          <field name="created_by"/>
          <group>
            <filter name="group_edu" string="Education Level" context="{'group_by': 'education_level'}"/>
          </group>
        </search>
      </field>
    </record>

    <!-- ── Job Profile Action ───────────────────────────────────────────── -->
    <record id="action_hr_resume_job" model="ir.actions.act_window">
      <field name="name">Resume Screening Jobs</field>
      <field name="res_model">hr.resume.job</field>
      <field name="view_mode">list,form</field>
      <field name="search_view_id" ref="hr_resume_job_search_view"/>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">No job profiles yet</p>
        <p>Go to <a href="/hrsd/resume">AI Resume Screening</a> to create one.</p>
      </field>
    </record>

    <!-- ── Candidate List ───────────────────────────────────────────────── -->
    <record id="hr_resume_candidate_list_view" model="ir.ui.view">
      <field name="name">hr.resume.candidate.list</field>
      <field name="model">hr.resume.candidate</field>
      <field name="arch" type="xml">
        <list string="Candidates" default_order="score_overall desc"
              decoration-success="state == 'shortlisted'"
              decoration-danger="state == 'rejected'">
          <field name="rank" string="#"/>
          <field name="name" string="Candidate"/>
          <field name="job_id" string="Job Profile"/>
          <field name="email"/>
          <field name="experience_years" string="Exp (yrs)"/>
          <field name="education_level"/>
          <field name="score_overall" string="Score (%)" widget="float" digits="[5,1]"/>
          <field name="state" string="Status" widget="badge"
                 decoration-success="state == 'shortlisted'"
                 decoration-danger="state == 'rejected'"/>
          <field name="uploaded_by"/>
          <field name="create_date" widget="datetime"/>
        </list>
      </field>
    </record>

    <!-- ── Candidate Form ───────────────────────────────────────────────── -->
    <record id="hr_resume_candidate_form_view" model="ir.ui.view">
      <field name="name">hr.resume.candidate.form</field>
      <field name="model">hr.resume.candidate</field>
      <field name="arch" type="xml">
        <form string="Resume Candidate">
          <header>
            <button name="action_shortlist" type="object" string="Shortlist" class="btn-success"
                    invisible="state == 'shortlisted'"/>
            <button name="action_reject" type="object" string="Reject"
                    invisible="state == 'rejected'"/>
            <field name="state" widget="statusbar" statusbar_visible="uploaded,parsed,scored,shortlisted,rejected"/>
          </header>
          <sheet>
            <div class="oe_title">
              <label for="name"/>
              <h1><field name="name" placeholder="Candidate Name…"/></h1>
            </div>
            <group>
              <group string="Contact">
                <field name="email"/>
                <field name="phone"/>
                <field name="employee_id"/>
              </group>
              <group string="Job &amp; Rank">
                <field name="job_id"/>
                <field name="rank"/>
                <field name="score_overall" readonly="1"/>
                <field name="uploaded_by" readonly="1"/>
              </group>
            </group>
            <group string="Extracted Info">
              <group>
                <field name="experience_years" readonly="1"/>
                <field name="education_level" readonly="1"/>
                <field name="file_name" readonly="1"/>
                <field name="file_size_kb" readonly="1"/>
              </group>
              <group string="Score Breakdown">
                <field name="score_skills" string="Skills Score (%)" readonly="1"/>
                <field name="score_experience" string="Experience Score (%)" readonly="1"/>
                <field name="score_education" string="Education Score (%)" readonly="1"/>
                <field name="score_content" string="Content Match (%)" readonly="1"/>
              </group>
            </group>
            <notebook>
              <page string="Resume Text" name="raw_text">
                <field name="raw_text" readonly="1"
                       style="font-family: monospace; font-size: 12px; min-height: 300px;"/>
              </page>
              <page string="Detected Skills" name="detected_skills">
                <field name="detected_skills" readonly="1"
                       style="font-family: monospace; font-size: 12px; min-height: 100px;"/>
              </page>
              <page string="HR Notes" name="notes">
                <field name="notes" placeholder="Add recruiting notes…"/>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <!-- ── Candidate Search ─────────────────────────────────────────────── -->
    <record id="hr_resume_candidate_search_view" model="ir.ui.view">
      <field name="name">hr.resume.candidate.search</field>
      <field name="model">hr.resume.candidate</field>
      <field name="arch" type="xml">
        <search string="Search Candidates">
          <field name="name" string="Candidate Name"/>
          <field name="job_id"/>
          <field name="email"/>
          <filter name="shortlisted" string="Shortlisted" domain="[('state','=','shortlisted')]"/>
          <filter name="rejected"    string="Rejected"    domain="[('state','=','rejected')]"/>
          <filter name="scored"      string="Scored"      domain="[('state','=','scored')]"/>
          <group>
            <filter name="group_job"  string="Job Profile"    context="{'group_by': 'job_id'}"/>
            <filter name="group_state" string="Status"        context="{'group_by': 'state'}"/>
            <filter name="group_edu"  string="Education Level" context="{'group_by': 'education_level'}"/>
          </group>
        </search>
      </field>
    </record>

    <!-- ── Candidate Action ─────────────────────────────────────────────── -->
    <record id="action_hr_resume_candidate" model="ir.actions.act_window">
      <field name="name">Resume Candidates</field>
      <field name="res_model">hr.resume.candidate</field>
      <field name="view_mode">list,form</field>
      <field name="search_view_id" ref="hr_resume_candidate_search_view"/>
      <field name="context">{'search_default_shortlisted': 0}</field>
    </record>

    <!-- ── Menu items ───────────────────────────────────────────────────── -->
    <menuitem id="menu_hrsd_resume_jobs"
              name="Resume Screening"
              parent="menu_hrsd_root"
              action="action_hr_resume_job"
              groups="hrsd.group_hrsd_confidential"
              sequence="30"/>

    <menuitem id="menu_hrsd_resume_candidates"
              name="All Candidates"
              parent="menu_hrsd_root"
              action="action_hr_resume_candidate"
              groups="hrsd.group_hrsd_confidential"
              sequence="31"/>

  </data>
</odoo>
