<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- ═══════════════════════════════════════════════════════════════════
         hrsd.dashboard.widget — controls whether the "Recent Activities"
         and "Upcoming Birthdays" panels on the HR Dashboard are shown, and
         to whom. Unlike Stat Cards / Top Navigation / Dashboard Menus,
         these default to Administrators-only until groups are added.
         ═══════════════════════════════════════════════════════════════════ -->

    <record id="hrsd_dashboard_widget_list_view" model="ir.ui.view">
      <field name="name">hrsd.dashboard.widget.list</field>
      <field name="model">hrsd.dashboard.widget</field>
      <field name="arch" type="xml">
        <list string="Dashboard Widgets" editable="bottom">
          <field name="key"/>
          <field name="group_ids" widget="many2many_tags" optional="show" placeholder="Administrators only"/>
          <field name="active" widget="boolean_toggle"/>
        </list>
      </field>
    </record>

    <record id="action_hrsd_dashboard_widget" model="ir.actions.act_window">
      <field name="name">Dashboard Widgets</field>
      <field name="res_model">hrsd.dashboard.widget</field>
      <field name="view_mode">list</field>
      <field name="help" type="html">
        <p>
          Controls whether the "Recent Activities" and "Upcoming Birthdays"
          panels on the HR Dashboard are shown, and to whom. By default only
          Administrators can see them — add groups here to let other users
          see them too, or turn a panel off entirely with the Active toggle.
        </p>
      </field>
    </record>

    <menuitem id="menu_hrsd_dashboard_widget_config"
              name="Dashboard Widgets"
              parent="menu_hrsd_root"
              action="action_hrsd_dashboard_widget"
              groups="base.group_system"
              sequence="103"/>

  </data>
</odoo>
