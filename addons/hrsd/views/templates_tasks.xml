<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

<template id="hrsd_tasks_page" name="Kanban Workspace Board">
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>To-Do Workspace Board · <t t-esc="brand['name']"/></title>
  <script type="text/javascript">
    (function () {
      try {
        var saved = localStorage.getItem('tsk-theme');
        var theme = saved === 'light' || saved === 'dark' ? saved : 'dark';
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();
  </script>
  <link rel="stylesheet" href="/hrsd/static/src/css/tasks.css"/>
</head>
<body>

<div class="tsk-shell">

  <header class="tsk-topbar">
    <a href="/hrsd/dashboard" class="tsk-brand">
      <t t-if="brand['logo_url']">
        <img t-attf-src="#{brand['logo_url']}" alt="logo" class="tsk-brand-mark" style="object-fit: contain; background: #fff; padding: 3px;"/>
      </t>
      <t t-else="">
        <span class="tsk-brand-mark"><t t-esc="brand['initial']"/></span>
      </t>
      <span class="tsk-brand-name"><t t-esc="brand['name']"/></span>
    </a>
    <div class="tsk-topbar-right">
      <a href="#" class="tsk-timesheet-link" id="tsk-timesheet-link" style="display:none;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2Z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="16" y2="17"/></svg>
        Timesheet Management
      </a>
      <a href="/hrsd/recruitment" class="tsk-back-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        Back to Careers Portal
      </a>
      <button type="button" class="tsk-theme-toggle" id="tsk-theme-toggle" aria-label="Switch between dark and light mode" title="Switch theme">
        <svg class="tsk-theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
        <svg class="tsk-theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/></svg>
      </button>
    </div>
  </header>

  <main class="tsk-main">

    <div class="tsk-empty-state" id="tsk-empty-state" style="display:none;">
      <div class="tsk-empty-title">No employee profile linked</div>
      <p>Your user account isn't linked to an HR employee record, so a personal to-do board and reporting hierarchy can't be shown. Ask an administrator to link your user under Employees.</p>
    </div>

    <div id="tsk-app">

      <div class="tsk-stats" id="tsk-stats"></div>

      <div class="tsk-content-grid">
        <div class="tsk-board-col">
          <div class="tsk-board-header">
            <div>
              <h1 class="tsk-board-title" id="tsk-board-title">My To-Do (Kanban)</h1>
              <p class="tsk-board-sub" id="tsk-board-sub">Manage tasks and track progress</p>
            </div>
          </div>

          <div class="tsk-switcher" id="tsk-switcher"></div>

          <div class="tsk-board-panel">
            <div class="tsk-toolbar">
              <div class="tsk-toolbar-left"></div>
              <div class="tsk-toolbar-right">
                <div class="tsk-filter-wrap">
                  <button type="button" class="tsk-toolbar-btn" id="tsk-filter-btn">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                    Filter
                    <span class="tsk-filter-count" id="tsk-filter-count" style="display:none;">0</span>
                  </button>
                  <div class="tsk-filter-panel" id="tsk-filter-panel">
                    <div class="tsk-filter-section">
                      <div class="tsk-filter-section-title">Priority</div>
                      <label class="tsk-filter-check"><input type="checkbox" data-filter-priority="critical"/> Critical</label>
                      <label class="tsk-filter-check"><input type="checkbox" data-filter-priority="high"/> High</label>
                      <label class="tsk-filter-check"><input type="checkbox" data-filter-priority="medium"/> Medium</label>
                      <label class="tsk-filter-check"><input type="checkbox" data-filter-priority="low"/> Low</label>
                    </div>
                    <div class="tsk-filter-section">
                      <div class="tsk-filter-section-title">Search</div>
                      <input type="text" id="tsk-filter-search" placeholder="Search task, tag, description..."/>
                    </div>
                    <div class="tsk-filter-actions">
                      <button type="button" class="tsk-btn-ghost" id="tsk-filter-clear">Clear filters</button>
                    </div>
                  </div>
                </div>

                <select class="tsk-groupby-select" id="tsk-groupby-select">
                  <option value="stage">Group by: Status</option>
                  <option value="priority">Group by: Priority</option>
                </select>

                <div class="tsk-view-toggle">
                  <button type="button" class="tsk-view-btn is-active" id="tsk-view-kanban" title="Kanban view">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="6" height="16" rx="1"/><rect x="11" y="4" width="6" height="10" rx="1"/><rect x="19" y="4" width="2" height="7" rx="1"/></svg>
                  </button>
                  <button type="button" class="tsk-view-btn" id="tsk-view-list" title="List view">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                  </button>
                </div>
              </div>
            </div>

            <section class="tsk-board" id="tsk-board"></section>
            <section class="tsk-list" id="tsk-list" style="display:none;"></section>
          </div>
        </div>

        <section class="tsk-panel tsk-hierarchy-panel">
          <div class="tsk-panel-header">
            <div class="tsk-panel-title">Reporting Hierarchy</div>
            <div class="tsk-panel-subtitle">Your reporting structure</div>
          </div>
          <div class="tsk-org-tree" id="tsk-org-tree"></div>
        </section>
      </div>

    </div>

  </main>

  <!-- ═══════════════════════ CREATE / EDIT TASK MODAL ═══════════════════════ -->
  <div class="tsk-modal-overlay" id="tsk-form-modal">
    <div class="tsk-modal">
      <div class="tsk-modal-header">
        <div>
          <h2 class="tsk-modal-title" id="tsk-form-title">New Task</h2>
          <p class="tsk-modal-sub">Add it to the board and it'll also land in that day's timesheet</p>
        </div>
        <button type="button" class="tsk-modal-close" data-action="close-form-modal">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="tsk-modal-body">
        <input type="hidden" id="tsk-form-id"/>

        <div class="tsk-field tsk-field-full">
          <label>Task <span class="tsk-required">*</span></label>
          <input type="text" id="tsk-form-name" placeholder="e.g. Prepare sprint report"/>
        </div>

        <div class="tsk-form-grid">
          <div class="tsk-field">
            <label>Assignee</label>
            <select id="tsk-form-employee"></select>
          </div>
          <div class="tsk-field">
            <label>Stage</label>
            <select id="tsk-form-stage">
              <t t-foreach="stage_options" t-as="s">
                <option t-att-value="s[0]" t-esc="s[1]"/>
              </t>
            </select>
          </div>
          <div class="tsk-field">
            <label>Priority</label>
            <select id="tsk-form-priority">
              <t t-foreach="priority_options" t-as="p">
                <option t-att-value="p[0]" t-esc="p[1]"/>
              </t>
            </select>
          </div>
          <div class="tsk-field">
            <label>Tag</label>
            <input type="text" id="tsk-form-tag" placeholder="e.g. Design, Feature, Bug"/>
          </div>
          <div class="tsk-field">
            <label>Date</label>
            <input type="date" id="tsk-form-date"/>
          </div>
          <div class="tsk-field">
            <label>Effort (Hours)</label>
            <input type="text" id="tsk-form-hours" placeholder="e.g. 2.5"/>
          </div>
        </div>

        <div class="tsk-field tsk-field-full">
          <label>Description</label>
          <textarea id="tsk-form-description" rows="3" placeholder="Optional details..."></textarea>
        </div>

        <div class="tsk-form-error" id="tsk-form-error" style="display:none;"></div>
      </div>
      <div class="tsk-modal-footer">
        <button type="button" class="tsk-btn-ghost" id="tsk-form-delete" style="display:none;">Delete</button>
        <div class="tsk-modal-footer-right">
          <button type="button" class="tsk-btn-ghost" data-action="close-form-modal">Cancel</button>
          <button type="button" class="tsk-btn-primary" id="tsk-form-submit">
            <span id="tsk-form-submit-label">Create Task</span>
          </button>
        </div>
      </div>
    </div>
  </div>

</div>

<script type="application/json" id="tsk-page-data"><t t-out="page_data_json"/></script>
<script type="text/javascript" src="/hrsd/static/src/js/tasks.js"></script>
</body>
</html>
</template>

</data>
</odoo>
