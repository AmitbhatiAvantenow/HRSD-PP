<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.ControlPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_control_panel_main_buttons')]" position="before">
            <button t-if="showHrsdBackButton"
                    type="button"
                    class="btn btn-link o_hrsd_back_btn d-print-none px-2 py-1"
                    t-att-title="hrsdBackTooltip"
                    data-hotkey="b"
                    t-on-click="onHrsdBackClick">
                <i class="oi oi-arrow-left me-1"/>
                <span class="d-none d-xl-inline" t-esc="hrsdBackTooltip"/>
            </button>
        </xpath>
    </t>

</templates>
