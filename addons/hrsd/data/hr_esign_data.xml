<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <record id="seq_hr_esign_document" model="ir.sequence">
      <field name="name">HR E-Sign Document</field>
      <field name="code">hr.esign.document</field>
      <field name="prefix">ESD</field>
      <field name="padding">6</field>
      <field name="number_next">1</field>
      <field name="number_increment">1</field>
    </record>

    <record id="cron_hr_esign_reminders" model="ir.cron">
      <field name="name">HR E-Sign: Smart Reminders</field>
      <field name="model_id" ref="model_hr_esign_document"/>
      <field name="state">code</field>
      <field name="code">model._cron_send_smart_reminders()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="active">True</field>
    </record>

  </data>
</odoo>
