      <field name="color">orange</field>
      <field name="url">/odoo/feedback-360</field>
      <field name="sequence">30</field>
    </record>

    <!-- 4. Employee Services -->
    <record id="dashboard_menu_services" model="hrsd.dashboard.menu">
      <field name="name">Employee Services</field>
      <field name="description">Handle leaves, requests, and employee support</field>
      <field name="icon">briefcase</field>
      <field name="color">orange</field>
      <field name="sequence">40</field>
    </record>
    <record id="dashboard_submenu_services_letters" model="hrsd.dashboard.submenu">
      <field name="menu_id" ref="dashboard_menu_services"/>
      <field name="name">HR Letters</field>
      <field name="description">Letters</field>
      <field name="icon">calendarCheck</field>
      <field name="color">blue</field>
      <field name="url">/odoo/hr-letters</field>
      <field name="sequence">10</field>
    </record>
    <record id="dashboard_submenu_services_visa" model="hrsd.dashboard.submenu">
      <field name="menu_id" ref="dashboard_menu_services"/>
