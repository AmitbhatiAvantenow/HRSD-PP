      <field name="icon">users</field>
      <field name="color">blue</field>
      <field name="url">/hrsd/resume</field>
      <field name="sequence">10</field>
    </record>
    <record id="dashboard_submenu_ai_attrition" model="hrsd.dashboard.submenu">
      <field name="menu_id" ref="dashboard_menu_ai"/>
