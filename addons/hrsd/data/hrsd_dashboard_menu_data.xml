      <field name="description">Predict employee attrition risk with ML analytics and get actionable retention recommendations before it's too late.</field>
      <field name="icon">chartBar</field>
      <field name="color">purple</field>
      <field name="url">/hrsd/attrition</field>
      <field name="sequence">20</field>
    </record>
    <record id="dashboard_submenu_ai_interview" model="hrsd.dashboard.submenu">
      <field name="menu_id" ref="dashboard_menu_ai"/>
      <field name="name">Interview Questions</field>
      <field name="description">Generate role-specific, competency-based interview questions instantly using AI. Free tier available via open-source LLMs.</field>
      <field name="icon">messageCircle</field>
      <field name="color">green</field>
      <field name="url">/hrsd/interview</field>
      <field name="sequence">30</field>
    </record>
    <record id="dashboard_submenu_ai_ocr" model="hrsd.dashboard.submenu">
      <field name="menu_id" ref="dashboard_menu_ai"/>
      <field name="name">OCR Document Scan</field>
      <field name="description">Extract and digitize text from HR documents, contracts and forms using optical character recognition (OCR).</field>
      <field name="icon">scan</field>
      <field name="color">orange</field>
      <field name="url">/hrsd/ocr</field>
      <field name="sequence">40</field>
    </record>

  </data>
</odoo>
