<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <!-- ═══════════════════════════════════════════════════════════════════
         Seed data for the configurable HR Portal dashboard menus/submenus.
         Mirrors what used to be hardcoded in dashboard.js / hrsd_dashboard.py
         so the dashboard looks identical after switching to the DB-driven
         version. Admins can add/edit/reorder everything from HR Portal >
         Dashboard Menus without touching code.
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- 1. Core HR Operations -->
    <record id="dashboard_menu_core_hr" model="hrsd.dashboard.menu">
      <field name="name">Core HR Operations</field>
      <field name="description">Open the main HR suite for employees, attendance, leave, payroll, department, and recruitment.</field>
      <field name="icon">users</field>
      <field name="color">blue</field>
      <field name="sequence">10</field>
    </record>
    <record id="dashboard_submenu_core_hr_employees" model="hrsd.dashboard.submenu">
      <field name="menu_id" ref="dashboard_menu_core_hr"/>
      <field name="name">Employees</field>
      <field name="description">Manage employee records and profiles.</field>
      <field name="icon">users</field>
      <field name="color">blue</field>
      <field name="url">/odoo/employees</field>
      <field name="sequence">10</field>
    </record>
    <record id="dashboard_submenu_core_hr_attendance" model="hrsd.dashboard.submenu">
      <field name="menu_id" ref="dashboard_menu_core_hr"/>
      <field name="name">Attendance</field>
      <field name="description">Track attendance and working hours.</field>
      <field name="icon">calendarCheck</field>
      <field name="color">green</field>
      <field name="url">/odoo/attendances</field>
      <field name="sequence">20</field>
    </record>
    <record id="dashboard_submenu_core_hr_leave" model="hrsd.dashboard.submenu">
      <field name="menu_id" ref="dashboard_menu_core_hr"/>
      <field name="name">Leave Management</field>
      <field name="description">Handle leave requests and approvals.</field>
      <field name="icon">fileText</field>
      <field name="color">purple</field>
      <field name="url">/odoo/time-off</field>
      <field name="sequence">30</field>
    </record>
    <record id="dashboard_submenu_core_hr_payroll" model="hrsd.dashboard.submenu">
      <field name="menu_id" ref="dashboard_menu_core_hr"/>
      <field name="name">Payroll</field>
      <field name="description">Process payroll and manage salaries.</field>
      <field name="icon">briefcase</field>
      <field name="color">orange</field>
      <field name="url">/odoo/payroll</field>
      <field name="sequence">40</field>
    </record>
    <record id="dashboard_submenu_core_hr_department" model="hrsd.dashboard.submenu">
      <field name="menu_id" ref="dashboard_menu_core_hr"/>
      <field name="name">Department</field>
      <field name="description">Manage departments and teams.</field>
      <field name="icon">users</field>
      <field name="color">indigo</field>
      <field name="url">/odoo/departments</field>
      <field name="sequence">50</field>
    </record>
    <record id="dashboard_submenu_core_hr_recruitment" model="hrsd.dashboard.submenu">
      <field name="menu_id" ref="dashboard_menu_core_hr"/>
      <field name="name">Recruitment</field>
      <field name="description">Manage job openings and applications.</field>
      <field name="icon">briefcase</field>
      <field name="color">pink</field>
      <field name="url">/hrsd/recruitment</field>
      <field name="sequence">60</field>
    </record>
    <record id="dashboard_submenu_core_hr_sign" model="hrsd.dashboard.submenu">
      <field name="menu_id" ref="dashboard_menu_core_hr"/>
      <field name="name">HR Sign</field>
      <field name="description">Create and manage secure HR document signing requests.</field>
      <field name="icon">fileText</field>
      <field name="color">green</field>
      <field name="url">/hrsign</field>
      <field name="sequence">70</field>
    </record>
    <record id="dashboard_submenu_core_hr_timesheet" model="hrsd.dashboard.submenu">
      <field name="menu_id" ref="dashboard_menu_core_hr"/>
      <field name="name">Timesheet</field>
      <field name="description">Track work hours, submit timesheets, and manage approvals efficiently.</field>
      <field name="icon">clock</field>
      <field name="color">blue</field>
      <field name="url">/odoo/timesheet</field>
      <field name="sequence">80</field>
    </record>
    <record id="dashboard_submenu_core_hr_crm" model="hrsd.dashboard.submenu">
      <field name="menu_id" ref="dashboard_menu_core_hr"/>
      <field name="name">CRM</field>
      <field name="description">Manage leads, track opportunities, nurture customer relationships, and close deals faster.</field>
      <field name="icon">briefcase</field>
      <field name="color">green</field>
      <field name="url">/odoo/crm</field>
      <field name="sequence">90</field>
    </record>

