      <field name="icon">award</field>
      <field name="color">pink</field>
      <field name="sequence">50</field>
    </record>
    <record id="dashboard_submenu_rewards_recognition" model="hrsd.dashboard.submenu">
      <field name="menu_id" ref="dashboard_menu_rewards"/>
