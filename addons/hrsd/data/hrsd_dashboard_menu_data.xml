      <field name="description">Nominate and celebrate outstanding contributions.</field>
      <field name="icon">award</field>
      <field name="color">blue</field>
      <field name="url">/odoo/recognition-awards</field>
      <field name="sequence">10</field>
    </record>

    <!-- 6. AI & Automation -->
    <record id="dashboard_menu_ai" model="hrsd.dashboard.menu">
      <field name="name">AI &amp; Automation</field>
      <field name="description">Leverage AI to automate HR tasks, predict attrition, generate interview questions and scan documents</field>
      <field name="icon">bot</field>
      <field name="color">indigo</field>
      <field name="sequence">60</field>
    </record>
    <record id="dashboard_submenu_ai_resume" model="hrsd.dashboard.submenu">
      <field name="menu_id" ref="dashboard_menu_ai"/>
